#!/usr/bin/env python3
"""
USBAnywhere Control Suite (macOS & Linux)
Unified management, interactive dashboard, and diagnostic tool for USBAnywhere Server.
Zero external dependencies. Works out-of-the-box on macOS (Apple Silicon & Intel) and Linux.

Copyright (c) 2025-2026 oscarlosu-lab - https://github.com/oscarlosu-lab/USBAnywhere-Server
Licensed under GPL v3
"""
import os
import sys
import platform
import subprocess
import socket
import struct
import time
import json
import shutil
import re
import argparse

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8")

VERSION = "3.3.0"
PORT = 3240
CONTROL_PORT = 3241

IS_MACOS = platform.system() == "Darwin"
IS_LINUX = platform.system() == "Linux"

# Terminal ANSI styling
GREEN = "\033[92m"
BLUE = "\033[94m"
CYAN = "\033[96m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"


POLICY_FILE = "/etc/usbanywhere/policy.json"
DEFAULT_POLICY = {
    "allow_all": True,
    "allowlist": [],
    "denylist": [],
    "protect_local_hid": False,
    "skip_classes": ["09"]
}

def load_policy(path=POLICY_FILE):
    """Load host export policy from JSON configuration file."""
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
                pol = DEFAULT_POLICY.copy()
                pol.update(data)
                return pol
        except Exception:
            pass
    return DEFAULT_POLICY.copy()

def save_policy(pol, path=POLICY_FILE):
    """Save host export policy to JSON configuration file."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(pol, f, indent=2)
        return True
    except Exception as e:
        print(f"{RED}Error saving policy: {e}{RESET}")
        return False

def is_valid_busid(busid):
    """Validate USB Bus ID format strictly to prevent path traversal and argument injection."""
    return bool(busid and isinstance(busid, str) and re.match(r"^\d+-[\d.]+$", busid.strip()))

def get_device_info(busid):
    """Inspect sysfs for a given busid on Linux and return (vid, pid, dev_class, if_classes, prod_name, mfg_name)."""
    if not IS_LINUX or not is_valid_busid(busid):
        return "", "", "", set(), "", ""
    dev_path = os.path.join("/sys/bus/usb/devices", busid.strip())
    if not os.path.exists(dev_path):
        return "", "", "", set(), "", ""
    
    vid, pid, dev_class = "", "", ""
    v_file = os.path.join(dev_path, "idVendor")
    d_file = os.path.join(dev_path, "idProduct")
    c_file = os.path.join(dev_path, "bDeviceClass")
    if os.path.isfile(v_file):
        try:
            with open(v_file, "r") as f: vid = f.read().strip().lower()
        except Exception: pass
    if os.path.isfile(d_file):
        try:
            with open(d_file, "r") as f: pid = f.read().strip().lower()
        except Exception: pass
    if os.path.isfile(c_file):
        try:
            with open(c_file, "r") as f: dev_class = f.read().strip().lower()
        except Exception: pass

    if_classes = set()
    try:
        for item in os.listdir(dev_path):
            if item.startswith(f"{busid}:"):
                if_cls_p = os.path.join(dev_path, item, "bInterfaceClass")
                if os.path.isfile(if_cls_p):
                    try:
                        with open(if_cls_p, "r") as f:
                            if_classes.add(f.read().strip().lower())
                    except Exception: pass
    except Exception: pass

    prod_name = ""
    p_file = os.path.join(dev_path, "product")
    if os.path.isfile(p_file):
        try:
            with open(p_file, "r") as f: prod_name = f.read().strip()
        except Exception: pass
    mfg_name = ""
    m_file = os.path.join(dev_path, "manufacturer")
    if os.path.isfile(m_file):
        try:
            with open(m_file, "r") as f: mfg_name = f.read().strip()
        except Exception: pass

    return vid, pid, dev_class, if_classes, prod_name, mfg_name

def is_device_export_allowed(busid, policy=None):
    """Check if device is allowed to be exported based on server export policy."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        return False, "Invalid BusId format"
    if policy is None:
        policy = load_policy()
    vid, pid, dev_class, if_classes, prod_name, mfg_name = get_device_info(busid)
    
    # Always prevent sharing USB Hubs (Class 09) and Linux Foundation root hubs
    if dev_class == "09" or "09" in if_classes or vid == "1d6b":
        return False, "USB Hubs cannot be shared"

    b_id = busid.lower().strip()
    vp = f"{vid}:{pid}".lower().strip() if (vid and pid) else ""

    # Denylist check (supports busid, vid:pid, or vid)
    denylist = [x.lower().strip() for x in policy.get("denylist", [])]
    if b_id in denylist or vp in denylist or (vid and vid in denylist):
        return False, f"Device {busid} ({vp}) is blocked by host denylist"

    # Local HID protection (protects local keyboards/mice/gamepads from remote grabbing)
    if policy.get("protect_local_hid", False):
        is_hid = (dev_class == "03" or "03" in if_classes or vid == "28de")
        if is_hid:
            return False, f"Device {busid} ({vp}) is protected local HID"

    # Allowlist check (if defined and non-empty)
    allowlist = [x.lower().strip() for x in policy.get("allowlist", [])]
    if allowlist:
        if not (b_id in allowlist or vp in allowlist or (vid and vid in allowlist)):
            return False, f"Device {busid} ({vp}) is not in host allowlist"

    return True, "OK"

# ══════════════════════════════════════════════════════════════════════════════
# HELPER UTILITIES
# ══════════════════════════════════════════════════════════════════════════════

def run_cmd(cmd, capture=True, check=False, timeout=30):
    """Run shell command safely without shell injection."""
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                             stderr=subprocess.PIPE if capture else None,
                             text=True, check=check, timeout=timeout)
        return res.stdout.strip() if capture else ""
    except Exception as e:
        if check:
            raise
        return ""

def is_root():
    """Check if script is running with superuser privileges."""
    return os.geteuid() == 0 if hasattr(os, "geteuid") else False

def get_lan_ip():
    """Find local LAN IPv4 address."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def is_port_open(host="127.0.0.1", port=PORT, timeout=1.0):
    """Check if USB/IP daemon is listening on TCP port."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        res = s.connect_ex((host, port))
        s.close()
        return res == 0
    except Exception:
        return False

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE CONTROLLERS (macOS launchd vs Linux systemd)
# ══════════════════════════════════════════════════════════════════════════════

def get_service_status():
    """Check background daemon status."""
    port_active = is_port_open()

    if IS_MACOS:
        plist_path = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        installed = os.path.exists(plist_path)
        out = run_cmd(["launchctl", "list"])
        running = "com.usbanywhere.server" in out
        return {
            "os": "macOS (Apple Silicon / Intel)",
            "service_manager": "launchd",
            "installed": installed,
            "running": running or port_active,
            "port_active": port_active
        }
    elif IS_LINUX:
        installed = os.path.exists("/etc/systemd/system/usbipd.service") or \
                    os.path.exists("/lib/systemd/system/usbipd.service")
        out = run_cmd(["systemctl", "is-active", "usbipd"])
        running = out == "active"
        return {
            "os": "Linux",
            "service_manager": "systemd",
            "installed": installed,
            "running": running or port_active,
            "port_active": port_active
        }
    else:
        return {
            "os": platform.system(),
            "service_manager": "unknown",
            "installed": False,
            "running": port_active,
            "port_active": port_active
        }

def start_service():
    """Start the USB/IP server service."""
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    if IS_MACOS:
        plist = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        if os.path.exists(plist):
            run_cmd(["launchctl", "load", "-w", plist])
            print(f"{GREEN}✓ macOS service started via launchd.{RESET}")
            return True
        else:
            print(f"{YELLOW}[!] Service plist not found. Running interactive daemon...{RESET}")
            subprocess.Popen(["usbanywhere-server-mac", "serve", "--auto-bind"])
            return True
    elif IS_LINUX:
        run_cmd(["systemctl", "restart", "usbipd"])
        print(f"{GREEN}✓ Linux service started via systemd.{RESET}")
        return True
    return False

def stop_service():
    """Stop the USB/IP server service."""
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    if IS_MACOS:
        plist = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        if os.path.exists(plist):
            run_cmd(["launchctl", "unload", "-w", plist])
        run_cmd(["pkill", "-f", "usbanywhere-server-mac"])
        print(f"{GREEN}✓ macOS service stopped.{RESET}")
        return True
    elif IS_LINUX:
        run_cmd(["systemctl", "stop", "usbipd"])
        run_cmd(["pkill", "-f", "usbipd"])
        print(f"{GREEN}✓ Linux service stopped.{RESET}")
        return True
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DEVICE INVENTORY (IOKit vs usbip / sysfs)
# ══════════════════════════════════════════════════════════════════════════════

def list_devices():
    """List local physical USB peripherals."""
    devices = []
    if IS_MACOS:
        # Use native macOS server CLI if installed
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "list", "--dynamic"])
            for line in out.splitlines():
                if ":" in line and line.strip():
                    devices.append(line.rstrip())
        else:
            # Fallback to system_profiler
            out = run_cmd(["system_profiler", "SPUSBDataType"])
            current = None
            for line in out.splitlines():
                line_str = line.strip()
                if line_str.endswith(":") and not any(k in line_str for k in ["Bus:", "Hub:", "Controller:"]):
                    current = line_str[:-1]
                elif "Product ID:" in line_str and current:
                    devices.append(f"• {current} ({line_str})")
                    current = None
    elif IS_LINUX:
        # 1. Direct sysfs scan for all physical USB peripherals (bound or unbound)
        sys_devs = "/sys/bus/usb/devices"
        if os.path.exists(sys_devs):
            for entry in sorted(os.listdir(sys_devs)):
                p = os.path.join(sys_devs, entry)
                v_file = os.path.join(p, "idVendor")
                d_file = os.path.join(p, "idProduct")
                if os.path.isfile(v_file) and os.path.isfile(d_file):
                    try:
                        with open(v_file, "r") as f:
                            vid = f.read().strip().lower()
                        with open(d_file, "r") as f:
                            pid = f.read().strip().lower()

                        cls_file = os.path.join(p, "bDeviceClass")
                        dev_class = ""
                        if os.path.isfile(cls_file):
                            with open(cls_file, "r") as f:
                                dev_class = f.read().strip().lower()

                        # Skip Hubs (Class 09) and Linux Foundation root hubs
                        if dev_class == "09" or vid == "1d6b" or entry.startswith("usb"):
                            continue

                        # Scan child interface classes for composite devices
                        if_classes = set()
                        for item in os.listdir(p):
                            if item.startswith(f"{entry}:"):
                                if_cls_p = os.path.join(p, item, "bInterfaceClass")
                                if os.path.isfile(if_cls_p):
                                    try:
                                        with open(if_cls_p, "r") as f:
                                            if_classes.add(f.read().strip().lower())
                                    except Exception:
                                        pass

                        prod_name = ""
                        p_file = os.path.join(p, "product")
                        if os.path.isfile(p_file):
                            with open(p_file, "r") as f:
                                prod_name = f.read().strip()
                        mfg_name = ""
                        m_file = os.path.join(p, "manufacturer")
                        if os.path.isfile(m_file):
                            with open(m_file, "r") as f:
                                mfg_name = f.read().strip()

                        # Valve Steam Controller special recognition
                        is_steam = (vid == "28de" and pid in ["1304", "1102", "1142", "11ff", "1205"])
                        if is_steam and not prod_name:
                            prod_name = "Steam Controller Wireless Receiver" if pid == "1304" else "Steam Controller"

                        # Determine functional class tag
                        tag = ""
                        if "03" in if_classes or dev_class == "03":
                            tag = " [HID/Gamepad]" if (is_steam or "gamepad" in prod_name.lower()) else " [HID]"
                        elif "08" in if_classes or dev_class == "08":
                            tag = " [Storage]"
                        elif "0e" in if_classes or dev_class == "0e":
                            tag = " [Video]"
                        elif "01" in if_classes or dev_class == "01":
                            tag = " [Audio]"

                        desc = f"{mfg_name} {prod_name}".strip() or "USB Device"
                        devices.append(f"  {entry}    : {desc}{tag} ({vid}:{pid})")
                    except Exception:
                        pass
        if not devices:
            bin_path = shutil.which("usbip")
            if bin_path:
                out = run_cmd([bin_path, "list", "-l"])
                curr_bus = None
                for line in out.splitlines():
                    if "busid" in line:
                        m = re.search(r"busid\s+([0-9a-zA-Z\-\.]+)\s+\((.*?)\)", line)
                        if m:
                            curr_bus = m.group(1)
                            desc = m.group(2)
                            devices.append(f"  {curr_bus}    : {desc}")
            else:
                out = run_cmd(["lsusb"])
                for line in out.splitlines():
                    if line.strip():
                        devices.append(line.strip())
    return devices

def share_device(busid):
    """Export a specific USB peripheral by bus ID."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        print(f"{RED}[Error] Invalid Bus ID format: {busid}{RESET}")
        return False

    allowed, reason = is_device_export_allowed(busid)
    if not allowed:
        print(f"{RED}[Policy Block] Cannot share {busid}: {reason}{RESET}")
        return False

    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    if IS_MACOS:
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "bind", busid])
            print(out or f"{GREEN}✓ Device {busid} shared.{RESET}")
            return True
    elif IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "bind", "-b", busid])
            print(out or f"{GREEN}✓ Device {busid} bound via usbip.{RESET}")
            return True
    return False

def unshare_device(busid):
    """Unshare a USB peripheral by bus ID."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        print(f"{RED}[Error] Invalid Bus ID format: {busid}{RESET}")
        return False

    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    if IS_MACOS:
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "unbind", busid])
            print(out or f"{GREEN}✓ Device {busid} unbound.{RESET}")
            return True
    elif IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "unbind", "-b", busid])
            print(out or f"{GREEN}✓ Device {busid} unbound via usbip.{RESET}")
            return True
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DYNAMIC AUTO-UNBIND & CONTROL API (Zero-Host-Lockout)
# ══════════════════════════════════════════════════════════════════════════════

def run_auto_unbind_daemon(interval=1.0, standalone=True):
    """
    Dynamic Auto-Unbind Watcher:
    Monitors /sys/bus/usb/drivers/usbip-host/*/usbip_status on Linux.
    When a remote client disconnects (status transitions from SDEV_ST_USED [2] to SDEV_ST_AVAILABLE [1]),
    automatically unbinds the peripheral so the local operating system (HTPC, Raspberry Pi, Steam Deck)
    instantly reclaims it without manual intervention.
    """
    if standalone:
        print(f"\n{CYAN}═══ 🔄 USBAnywhere Dynamic Auto-Unbind Daemon ═══{RESET}")
        print(f"Monitoring USB/IP client disconnects (Poll interval: {interval}s)...")
    
    prev_statuses = {}
    
    while True:
        try:
            if IS_LINUX:
                sysfs_base = "/sys/bus/usb/drivers/usbip-host"
                if os.path.exists(sysfs_base):
                    for entry in os.listdir(sysfs_base):
                        status_file = os.path.join(sysfs_base, entry, "usbip_status")
                        if os.path.isfile(status_file):
                            try:
                                with open(status_file, "r") as f:
                                    raw = f.read().strip()
                                status_code = int(raw) if raw.isdigit() else -1
                                
                                prev = prev_statuses.get(entry)
                                # 2 = SDEV_ST_USED (client attached)
                                # 1 = SDEV_ST_AVAILABLE (idle shared)
                                if prev == 2 and status_code == 1:
                                    print(f"{YELLOW}[Auto-Unbind] Remote client disconnected from device {entry}.{RESET}")
                                    print(f"{GREEN}✓ Auto-releasing {entry} back to local host OS...{RESET}")
                                    unshare_device(entry)
                                    prev_statuses.pop(entry, None)
                                    continue
                                
                                prev_statuses[entry] = status_code
                            except Exception:
                                pass
            elif IS_MACOS:
                bin_path = shutil.which("usbanywhere-server-mac")
                if bin_path:
                    out = run_cmd([bin_path, "status", "--json"])
                    if out:
                        try:
                            data = json.loads(out)
                            for dev in data.get("devices", []):
                                bid = dev.get("busid")
                                clients = dev.get("connected_clients", 0)
                                prev_c = prev_statuses.get(bid, 0)
                                if prev_c > 0 and clients == 0:
                                    print(f"{YELLOW}[Auto-Unbind] Client disconnected from {bid}. Auto-releasing...{RESET}")
                                    unshare_device(bid)
                                prev_statuses[bid] = clients
                        except Exception:
                            pass
            time.sleep(interval)
        except KeyboardInterrupt:
            if standalone:
                print(f"\n{YELLOW}Auto-unbind daemon stopped.{RESET}")
            break
        except Exception:
            time.sleep(interval)

def handle_control_client(sock, addr):
    """Handle incoming on-demand control command (TCP 3241)."""
    try:
        sock.settimeout(5.0)
        data = sock.recv(1024).decode("utf-8").strip()
        if not data:
            sock.close()
            return
        
        parts = data.split()
        cmd = parts[0].upper()
        
        if cmd == "LIST":
            devs = list_devices()
            resp = json.dumps({"status": "OK", "devices": devs}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "BIND" and len(parts) > 1:
            target_bus = parts[1]
            if not re.match(r"^\d+-[\d.]+$", target_bus):
                resp = json.dumps({"status": "ERROR", "busid": target_bus, "action": "bind", "message": "Invalid BusId"}) + "\n"
                sock.sendall(resp.encode("utf-8"))
                return
            allowed, reason = is_device_export_allowed(target_bus)
            if not allowed:
                resp = json.dumps({"status": "DENIED", "busid": target_bus, "action": "bind", "message": reason}) + "\n"
                sock.sendall(resp.encode("utf-8"))
            else:
                ok = share_device(target_bus)
                resp = json.dumps({"status": "OK" if ok else "ERROR", "busid": target_bus, "action": "bind"}) + "\n"
                sock.sendall(resp.encode("utf-8"))
        elif cmd == "POLICY":
            pol = load_policy()
            resp = json.dumps({"status": "OK", "policy": pol}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "UNBIND" and len(parts) > 1:
            target_bus = parts[1]
            if not re.match(r"^\d+-[\d.]+$", target_bus):
                resp = json.dumps({"status": "ERROR", "busid": target_bus, "action": "unbind", "message": "Invalid BusId"}) + "\n"
                sock.sendall(resp.encode("utf-8"))
                return
            ok = unshare_device(target_bus)
            resp = json.dumps({"status": "OK" if ok else "ERROR", "busid": target_bus, "action": "unbind"}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "STATUS":
            st = get_service_status()
            resp = json.dumps(st) + "\n"
            sock.sendall(resp.encode("utf-8"))
        else:
            sock.sendall(b'{"status": "ERROR", "message": "Unknown command"}\n')
    except Exception as e:
        try:
            err_resp = json.dumps({"status": "ERROR", "message": str(e)}) + "\n"
            sock.sendall(err_resp.encode("utf-8"))
        except Exception:
            pass
    finally:
        try:
            sock.close()
        except Exception:
            pass

def run_udp_discovery_responder(port=CONTROL_PORT):
    """Listen for incoming UDP discovery probes on port 3241 and reply with server identity."""
    try:
        udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if hasattr(socket, "SO_BROADCAST"):
            udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        udp_sock.bind(("0.0.0.0", port))
        
        while True:
            try:
                data, addr = udp_sock.recvfrom(1024)
                msg = data.decode("utf-8", errors="ignore").strip()
                if "USBANYWHERE_DISCOVERY_PROBE" in msg or "DISCOVERY" in msg:
                    host = socket.gethostname()
                    resp = f"USBANYWHERE_SERVER:{host}\n".encode("utf-8")
                    udp_sock.sendto(resp, addr)
            except Exception:
                time.sleep(0.05)
    except Exception:
        pass

def run_dynamic_daemon(port=CONTROL_PORT):
    """Run dynamic daemon with both background auto-unbind watcher and on-demand control listener."""
    import threading
    
    print(f"\n{CYAN}═══ ⚡ USBAnywhere Dynamic Multi-Tenant Daemon ═══{RESET}")
    print(f"• Dynamic Auto-Unbind: ACTIVE (Devices released to local OS when client disconnects)")
    print(f"• Control Socket:      LISTENING on TCP port {port} (On-demand BIND / UNBIND API)")
    print(f"• Discovery Responder: LISTENING on UDP port {port} (Broadcast Auto-Scan Responder)")
    print(f"• Main USB/IP Port:    LISTENING on TCP port {PORT}")
    
    watcher_t = threading.Thread(target=run_auto_unbind_daemon, kwargs={"interval": 1.0, "standalone": False}, daemon=True)
    watcher_t.start()

    udp_t = threading.Thread(target=run_udp_discovery_responder, kwargs={"port": port}, daemon=True)
    udp_t.start()
    
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("0.0.0.0", port))
        srv.listen(5)
    except Exception as e:
        print(f"{RED}Error binding to control port {port}: {e}{RESET}")
        return
        
    try:
        while True:
            client_sock, addr = srv.accept()
            threading.Thread(target=handle_control_client, args=(client_sock, addr), daemon=True).start()
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Dynamic daemon stopped.{RESET}")
    finally:
        srv.close()

# ══════════════════════════════════════════════════════════════════════════════
# DIAGNOSTICS & SELF-TEST
# ══════════════════════════════════════════════════════════════════════════════

def run_self_test(host="127.0.0.1", port=PORT):
    """Run binary loopback protocol handshake test."""
    print(f"\n{CYAN}═══ 🧪 USBAnywhere Binary Protocol Self-Test ═══{RESET}")
    print(f"Connecting to {host}:{port}...")

    s = None
    for attempt in range(1, 4):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(3.0)
            s.connect((host, port))
            print(f"{GREEN}✓ TCP Connection established on port {port}{RESET}")
            break
        except Exception as e:
            time.sleep(0.5)
            if attempt == 3:
                print(f"{RED}✗ FAILED: Could not connect to port {port} ({e}){RESET}")
                return False

    try:
        # Send OP_REQ_DEVLIST (0x0111, 0x8005, 0x00000000)
        req = struct.pack(">HHI", 0x0111, 0x8005, 0)
        s.sendall(req)

        header = s.recv(8)
        if len(header) < 8:
            print(f"{RED}✗ FAILED: Expected 8 header bytes, received {len(header)}{RESET}")
            s.close()
            return False

        version, cmd, status = struct.unpack(">HHI", header)
        print(f"Received Header: Version=0x{version:04X}, Cmd=0x{cmd:04X}, Status={status}")

        if version == 0x0111 and cmd == 0x0005 and status == 0:
            ndev_bytes = s.recv(4)
            ndev = struct.unpack(">I", ndev_bytes)[0] if len(ndev_bytes) == 4 else 0
            print(f"{GREEN}✓ USB/IP OP_REP_DEVLIST valid! Exported devices: {ndev}{RESET}")
            s.close()
            print(f"{GREEN}✓ PROTOCOL SELF-TEST PASSED: Server is fully operational!{RESET}\n")
            return True
        else:
            print(f"{RED}✗ FAILED: Protocol header mismatch.{RESET}")
            s.close()
            return False
    except Exception as e:
        print(f"{RED}✗ FAILED with exception: {e}{RESET}")
        if s: s.close()
        return False

def run_doctor():
    """System health check and diagnostic inspection."""
    print(f"\n{BOLD}{CYAN}═══ 🩺 USBAnywhere System Doctor ═══{RESET}\n")

    # 1. OS & Kernel
    os_name = platform.system()
    arch = platform.machine()
    print(f"• Operating System:   {BOLD}{os_name} ({arch}){RESET}")
    print(f"• Kernel Version:     {platform.release()}")

    # 2. Permissions
    root = is_root()
    root_str = f"{GREEN}YES (root){RESET}" if root else f"{YELLOW}NO (standard user){RESET}"
    print(f"• Superuser Privs:    {root_str}")

    # 3. Port & Service
    st = get_service_status()
    srv_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
    port_str = f"{GREEN}LISTENING (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"
    print(f"• Service Status:     {srv_str} (via {st['service_manager']})")
    print(f"• Network Listener:   {port_str}")
    print(f"• Local LAN IPv4:     {CYAN}{get_lan_ip()}{RESET}")

    # 4. Kernel Modules (Linux only)
    if IS_LINUX:
        lsmod = run_cmd(["lsmod"])
        has_core = "usbip_core" in lsmod
        has_host = "usbip_host" in lsmod
        core_str = f"{GREEN}LOADED{RESET}" if has_core else f"{RED}MISSING (run: sudo modprobe usbip_core){RESET}"
        host_str = f"{GREEN}LOADED{RESET}" if has_host else f"{RED}MISSING (run: sudo modprobe usbip_host){RESET}"
        print(f"• Kernel Module core: {core_str}")
        print(f"• Kernel Module host: {host_str}")

        # Check Raspberry Pi legacy dwc_otg driver (causes kernel Oops in stub_send_ret_submit behind USB 2.0 Hub HATs)
        if os.path.exists("/sys/bus/platform/drivers/dwc_otg") and any(
            x.startswith("20980000.usb") or x.startswith("3f980000.usb") or x.startswith("fe980000.usb")
            for x in os.listdir("/sys/bus/platform/drivers/dwc_otg")
        ):
            print(f"• RPi USB Controller: {YELLOW}WARNING: Legacy 'dwc_otg' active!{RESET}")
            print(f"    {YELLOW}↳ High-speed HID/DualSense behind USB 2.0 Hub HATs may trigger a kernel Oops.{RESET}")
            print(f"    {CYAN}↳ Fix: Run 'sudo usbanywhere-ctl fix-dualsense' or add 'dtoverlay=dwc2,dr_mode=host' to /boot/firmware/config.txt{RESET}")
        elif os.path.exists("/sys/bus/platform/drivers/dwc2"):
            print(f"• RPi USB Controller: {GREEN}dwc2 (Modern split-transaction safe){RESET}")

        dualsense_rule = "/etc/udev/rules.d/99-usbanywhere-dualsense-fix.rules"
        if os.path.exists(dualsense_rule):
            print(f"• DualSense Quirk:    {GREEN}INSTALLED ({dualsense_rule}){RESET}")

    # 5. Device Inventory
    devs = list_devices()
    print(f"• USB Devices Found:  {BOLD}{len(devs)}{RESET}")
    for d in devs[:5]:
        print(f"    {DIM}{d}{RESET}")
    if len(devs) > 5:
        print(f"    {DIM}... and {len(devs) - 5} more{RESET}")

    print(f"\n{GREEN}Doctor completed.{RESET}\n")

# ══════════════════════════════════════════════════════════════════════════════
# INTERACTIVE DASHBOARD / TUI
# ══════════════════════════════════════════════════════════════════════════════

def render_dashboard():
    """Interactive Control Suite Terminal Dashboard."""
    while True:
        # Clear screen
        os.system("clear" if os.name != "nt" else "cls")

        st = get_service_status()
        lan_ip = get_lan_ip()
        devs = list_devices()

        status_badge = f"{GREEN}● ACTIVE{RESET}" if st["running"] else f"{RED}○ STOPPED{RESET}"
        port_badge = f"{GREEN}OPEN (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"

        print(f"""
{CYAN}╔══════════════════════════════════════════════════════════════════════════════╗
║                 🎛️  {BOLD}USBAnywhere Control Suite v{VERSION}{RESET}{CYAN}                           ║
║   Share local USB peripherals over network (Moonlight/Sunshine/Sim/Work)     ║
╚══════════════════════════════════════════════════════════════════════════════╝{RESET}
  • {BOLD}OS:{RESET} {st['os']}
  • {BOLD}Server Daemon:{RESET} {status_badge}  |  {BOLD}Port 3240:{RESET} {port_badge}
  • {BOLD}Server IP (LAN):{RESET} {BOLD}{GREEN}{lan_ip}{RESET}  (Enter this IP in USBAnywhere Windows Client)
  • {BOLD}Service Manager:{RESET} {st['service_manager']}

{BOLD}📋 Discovered Physical USB Peripherals ({len(devs)}):{RESET}""")

        if not devs:
            print(f"  {YELLOW}No USB devices discovered or permission required.{RESET}")
        else:
            for idx, d in enumerate(devs[:8], start=1):
                print(f"  {BOLD}[{idx}]{RESET} {d}")
            if len(devs) > 8:
                print(f"  {DIM}... ({len(devs) - 8} more devices){RESET}")

        print(f"""
{CYAN}═══════════════════════════════ CONTROL ACTIONS ═══════════════════════════════{RESET}
  {BOLD}[1]{RESET} Start / Restart Service       {BOLD}[5]{RESET} Run Health Doctor
  {BOLD}[2]{RESET} Stop Service                  {BOLD}[6]{RESET} Run Protocol Self-Test
  {BOLD}[3]{RESET} Share a USB Device            {BOLD}[7]{RESET} View Live Logs
  {BOLD}[4]{RESET} Unshare a USB Device          {BOLD}[8]{RESET} Refresh Dashboard
  {BOLD}[9]{RESET} Client: Connect Remote USB    {BOLD}[0]{RESET} Client: Detach Remote USB
  {BOLD}[q]{RESET} Quit Control Suite
""")

        choice = input(f"{BOLD}Select an action [0-9, q]: {RESET}").strip().lower()

        if choice == "1":
            start_service()
            time.sleep(2)
        elif choice == "2":
            stop_service()
            time.sleep(1.5)
        elif choice == "3":
            bus = input("Enter USB Bus ID to share (e.g. 1-1): ").strip()
            if bus:
                share_device(bus)
                time.sleep(2)
        elif choice == "4":
            bus = input("Enter USB Bus ID to unshare: ").strip()
            if bus:
                unshare_device(bus)
                time.sleep(2)
        elif choice == "5":
            run_doctor()
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "6":
            run_self_test()
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "7":
            if IS_MACOS:
                log_file = "/var/log/usbanywhere-server.log"
                if os.path.exists(log_file):
                    os.system(f"tail -n 30 {log_file}")
                else:
                    print("Log file /var/log/usbanywhere-server.log does not exist yet.")
            elif IS_LINUX:
                os.system("journalctl -u usbipd -n 30 --no-pager")
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "8" or choice == "":
            continue
        elif choice == "9":
            scan_network_servers()
            srv_ip = input("Enter Remote Server IP (e.g. 192.168.1.50): ").strip()
            if srv_ip:
                list_remote_devices(srv_ip)
                rem_bus = input("Enter Remote Bus ID to attach (e.g. 1-1): ").strip()
                if rem_bus:
                    connect_remote_device(srv_ip, rem_bus)
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "0":
            list_client_ports()
            port_or_bus = input("Enter Port number, Bus ID, or 'all' to detach: ").strip()
            if port_or_bus:
                disconnect_remote_device(port_or_bus)
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice in ["q", "quit", "exit"]:
            print(f"\n{GREEN}Exiting USBAnywhere Control Suite. Have a great day!{RESET}\n")
            break

# ══════════════════════════════════════════════════════════════════════════════
# LINUX CLIENT MODE (vhci_hcd + On-Demand Dynamic BIND/UNBIND TCP 3241)
# ══════════════════════════════════════════════════════════════════════════════

def is_valid_host(host):
    """Validate hostname or IPv4 address strictly against command injection."""
    return bool(host and isinstance(host, str) and re.match(r"^[a-zA-Z0-9.\-_]+$", host.strip()))

def send_control_command(server_ip, cmd_line, port=CONTROL_PORT, timeout=2.5):
    """Send a single-line control command to remote TCP 3241 daemon and parse JSON response."""
    if not is_valid_host(server_ip):
        return None
    try:
        with socket.create_connection((server_ip.strip(), port), timeout=timeout) as s:
            s.sendall((cmd_line.strip() + "\n").encode("utf-8"))
            raw = s.recv(16384).decode("utf-8", errors="ignore").strip()
            if raw:
                return json.loads(raw.splitlines()[0])
    except Exception:
        pass
    return None

def scan_network_servers(port=CONTROL_PORT, timeout=1.2):
    """Broadcast UDP discovery probe on port 3241 to find USB/IP servers on LAN."""
    print(f"\n{CYAN}═══ 🔍 Scanning LAN for USB/IP Servers (UDP {port}) ═══{RESET}")
    found = []
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.settimeout(0.35)
        targets = {"255.255.255.255"}
        lan_ip = get_lan_ip()
        if lan_ip and "." in lan_ip and not lan_ip.startswith("127."):
            parts = lan_ip.split(".")
            if len(parts) == 4:
                targets.add(f"{parts[0]}.{parts[1]}.{parts[2]}.255")
        for bcast in targets:
            for probe in (b"USBANYWHERE_DISCOVERY_PROBE\n", b"USBANYWHERE_DISCOVERY_PROBE\n"):
                try:
                    sock.sendto(probe, (bcast, port))
                except Exception:
                    pass
        deadline = time.time() + timeout
        seen_ips = set()
        while time.time() < deadline:
            try:
                data, addr = sock.recvfrom(1024)
                ip = addr[0]
                if ip not in seen_ips:
                    seen_ips.add(ip)
                    msg = data.decode("utf-8", errors="ignore").strip()
                    host = msg.split(":", 1)[1] if ":" in msg else msg
                    found.append((ip, host))
            except socket.timeout:
                continue
            except Exception:
                break
        sock.close()
    except Exception as e:
        print(f"{YELLOW}Discovery warning: {e}{RESET}")

    if found:
        for ip, host in found:
            print(f"  {GREEN}●{RESET} {BOLD}{ip}{RESET} ({host})")
    else:
        print(f"  {DIM}No broadcast responders replied within {timeout:.1f}s (you can still connect by direct IP).{RESET}")
    return found

def list_remote_devices(server_ip):
    """List remote USB devices on server_ip using both TCP 3241 dynamic inventory and TCP 3240."""
    if not is_valid_host(server_ip):
        print(f"{RED}[Error] Invalid server IP or hostname: {server_ip}{RESET}")
        return []
    ip = server_ip.strip()
    print(f"\n{CYAN}═══ 🌐 Remote USB Devices on {ip} ═══{RESET}")
    results = []

    # 1. Query On-Demand Dynamic Control API (TCP 3241)
    dyn = send_control_command(ip, "LIST")
    if isinstance(dyn, dict) and isinstance(dyn.get("devices"), list):
        for item in dyn["devices"]:
            if isinstance(item, dict):
                bid = item.get("busid") or item.get("busId") or ""
                vid = item.get("vid") or item.get("vendorId") or ""
                pid = item.get("pid") or item.get("productId") or ""
                prod = item.get("product") or item.get("description") or "USB Device"
                line = f"  {bid:<8} : {prod} ({vid}:{pid})"
                results.append(line)
            elif isinstance(item, str) and item.strip():
                results.append("  " + item.strip())

    # 2. Fallback / supplement via standard usbip list -r <ip> (TCP 3240)
    if not results:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "list", "-r", ip])
            for line in out.splitlines():
                if re.search(r"^\s*\d+-[\d.]+\s*:", line):
                    results.append("  " + line.strip())

    if results:
        for r in results:
            print(r)
    else:
        print(f"  {YELLOW}No remote USB devices found on {ip} (verify server IP and ports 3240/3241).{RESET}")
    return results

def connect_remote_device(server_ip, busid):
    """Attach a remote USB/IP device into local Linux vhci_hcd client driver (with on-demand TCP 3241 BIND)."""
    if not IS_LINUX:
        print(f"{RED}[Error] Native vhci_hcd client attach is only supported on Linux.{RESET}")
        return False
    if not is_valid_host(server_ip) or not is_valid_busid(busid):
        print(f"{RED}[Error] Invalid Server IP ({server_ip}) or Bus ID ({busid}).{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required for vhci_hcd attach. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    ip = server_ip.strip()
    bid = busid.strip()

    # 1. Load Linux USB/IP client kernel modules
    run_cmd(["modprobe", "usbip_core"])
    run_cmd(["modprobe", "vhci_hcd"])

    # 2. Request on-demand BIND via TCP 3241 if server supports Dynamic Control
    bind_resp = send_control_command(ip, f"BIND {bid}")
    if isinstance(bind_resp, dict):
        st = (bind_resp.get("status") or "").upper()
        if st == "DENIED":
            print(f"{RED}[Policy Denied] Remote server blocked export of {bid}: {bind_resp.get('message')}{RESET}")
            return False
        elif st == "OK":
            print(f"{GREEN}✓ On-demand BIND {bid} accepted by {ip}:{CONTROL_PORT}{RESET}")
            time.sleep(0.25)

    # 3. Attach into local vhci_hcd
    bin_path = shutil.which("usbip")
    if not bin_path:
        print(f"{RED}[Error] 'usbip' client binary not found. Install linux-tools-generic or usbip.{RESET}")
        return False

    out = run_cmd([bin_path, "attach", "-r", ip, "-b", bid])
    if "error" in out.lower() or "failed" in out.lower():
        print(f"{RED}✗ Failed to attach {bid} from {ip}: {out}{RESET}")
        return False

    print(f"{GREEN}✓ Attached {bid} from {ip} into local Linux vhci_hcd!{RESET}")
    return True

def parse_client_ports(port_output):
    """Parse 'usbip port' output into list of dicts: [{'port': '00', 'ip': '...', 'busid': '...', 'desc': '...'}]."""
    entries = []
    cur = None
    for line in (port_output or "").splitlines():
        m_port = re.search(r"Port\s+(\d+)\s*:", line, re.IGNORECASE)
        if m_port:
            if cur:
                entries.append(cur)
            cur = {"port": str(int(m_port.group(1))), "ip": "", "busid": "", "desc": line.strip()}
            continue
        if cur:
            m_url = re.search(r"usbip://([a-zA-Z0-9.\-_]+):\d+/(\d+-[\d.]+)", line)
            if m_url:
                cur["ip"] = m_url.group(1)
                cur["busid"] = m_url.group(2)
            else:
                m_bus = re.search(r"busid\s+(\d+-[\d.]+)", line, re.IGNORECASE)
                if m_bus and not cur["busid"]:
                    cur["busid"] = m_bus.group(1)
            if "->" not in line and not m_url and line.strip():
                cur["desc"] = line.strip()
    if cur:
        entries.append(cur)
    return entries

def list_client_ports():
    """Display currently attached remote USB devices on this Linux client."""
    bin_path = shutil.which("usbip")
    if not bin_path:
        print(f"{YELLOW}'usbip' binary not found.{RESET}")
        return []
    out = run_cmd([bin_path, "port"])
    entries = parse_client_ports(out)
    print(f"\n{CYAN}═══ 🔌 Attached Remote USB Ports ({len(entries)}) ═══{RESET}")
    if not entries:
        print(f"  {DIM}No remote USB devices currently attached.{RESET}")
    else:
        for e in entries:
            remote_str = f"{e['ip']}/{e['busid']}" if e["ip"] or e["busid"] else "remote"
            print(f"  • Port {BOLD}{e['port']}{RESET}: {remote_str} — {e['desc']}")
    return entries

def disconnect_remote_device(target="all"):
    """Detach a remote USB/IP port on Linux client and send on-demand UNBIND to remote TCP 3241."""
    if not IS_LINUX:
        print(f"{RED}[Error] Native vhci_hcd client detach is only supported on Linux.{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required for vhci_hcd detach. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    bin_path = shutil.which("usbip")
    if not bin_path:
        print(f"{RED}[Error] 'usbip' client binary not found.{RESET}")
        return False

    entries = parse_client_ports(run_cmd([bin_path, "port"]))
    if not entries:
        print(f"{YELLOW}No attached USB/IP client ports found.{RESET}")
        return True

    tgt = (target or "all").strip().lower()
    matched = [
        e for e in entries
        if tgt == "all" or e["port"] == tgt.lstrip("0") or e["port"] == tgt or e["busid"].lower() == tgt
    ]
    if not matched and tgt.isdigit():
        matched = [{"port": tgt, "ip": "", "busid": "", "desc": ""}]

    for e in matched:
        run_cmd([bin_path, "detach", "-p", e["port"]])
        print(f"{GREEN}✓ Detached local vhci_hcd Port {e['port']}{RESET}")
        if e["ip"] and e["busid"]:
            unbind_resp = send_control_command(e["ip"], f"UNBIND {e['busid']}")
            if isinstance(unbind_resp, dict) and (unbind_resp.get("status") or "").upper() == "OK":
                print(f"{GREEN}✓ Released {e['busid']} back to remote host {e['ip']}{RESET}")
    return True

# ══════════════════════════════════════════════════════════════════════════════
# MAIN DISPATCHER
# ══════════════════════════════════════════════════════════════════════════════

def apply_dualsense_fix():
    """Install udev quirk for Sony DualSense (054c:0ce6 / 054c:0df2) and check Raspberry Pi dwc2 overlay."""
    if not IS_LINUX:
        print(f"{YELLOW}DualSense udev/dwc2 fix is only applicable on Linux / Raspberry Pi hosts.{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return subprocess.run(["sudo", sys.executable, *sys.argv], timeout=30).returncode == 0

    rule_path = "/etc/udev/rules.d/99-usbanywhere-dualsense-fix.rules"
    rule_content = (
        "# USBAnywhere — Prevent hid-playstation race, USB autosuspend, and ARM64 usbip_host isoc audio Oops on DualSense / DualSense Edge\n"
        'ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0ce6", ATTR{power/control}="on"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0df2", ATTR{power/control}="on"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", ATTR{bInterfaceClass}=="01", ATTR{authorized}="0"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", ATTR{bInterfaceClass}=="01", ATTR{authorized}="0"\n'
        'ACTION=="add", SUBSYSTEM=="hid", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", RUN+="/bin/sh -c \'echo $kernel > /sys/bus/hid/drivers/playstation/unbind 2>/dev/null || true\'"\n'
        'ACTION=="add", SUBSYSTEM=="hid", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", RUN+="/bin/sh -c \'echo $kernel > /sys/bus/hid/drivers/playstation/unbind 2>/dev/null || true\'"\n'
    )
    try:
        os.makedirs("/etc/udev/rules.d", exist_ok=True)
        with open(rule_path, "w", encoding="utf-8") as f:
            f.write(rule_content)
        run_cmd(["udevadm", "control", "--reload-rules"])
        run_cmd(["udevadm", "trigger"])
        print(f"{GREEN}✓ Installed DualSense udev protection rule at {rule_path}{RESET}")
    except Exception as e:
        print(f"{RED}✗ Failed to write udev rule: {e}{RESET}")
        return False

    # Check Raspberry Pi config.txt for dwc2 host mode if dwc_otg is currently bound
    for cfg in ("/boot/firmware/config.txt", "/boot/config.txt"):
        if os.path.isfile(cfg):
            try:
                with open(cfg, "r", encoding="utf-8") as f:
                    txt = f.read()
                if "dtoverlay=dwc2" not in txt:
                    print(f"{YELLOW}[!] Raspberry Pi detected ({cfg}) without 'dtoverlay=dwc2,dr_mode=host'.{RESET}")
                    print(f"    To prevent dwc_otg kernel Oops behind USB 2.0 Hub HATs, add under [all]:")
                    print(f"    {CYAN}dtoverlay=dwc2,dr_mode=host{RESET}")
            except Exception:
                pass
            break
    return True

def main():
    parser = argparse.ArgumentParser(
        description=f"USBAnywhere Control Suite v{VERSION} — macOS & Linux",
        epilog="Run without arguments to launch interactive Control Dashboard."
    )
    parser.add_argument("command", nargs="?", default="dashboard",
                        choices=["dashboard", "status", "start", "stop", "restart",
                                 "list", "share", "unshare", "policy", "auto-unbind",
                                 "dynamic-daemon", "fix-dualsense", "doctor", "test", "logs",
                                 "scan", "remote", "connect", "attach", "disconnect", "detach", "ports"],
                        help="Action to perform (default: interactive dashboard)")
    parser.add_argument("busid", nargs="?", default=None, help="Target USB bus ID or action parameter")
    parser.add_argument("extra", nargs="?", default=None, help="Additional argument for policy management")
    parser.add_argument("--json", action="store_true", help="Output status in JSON format")

    args = parser.parse_args()

    if args.command == "dashboard":
        render_dashboard()
    elif args.command == "status":
        st = get_service_status()
        st["lan_ip"] = get_lan_ip()
        st["devices"] = list_devices()
        if args.json:
            print(json.dumps(st, indent=2))
        else:
            status_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
            print(f"USBAnywhere Server: {status_str} (via {st['service_manager']})")
            print(f"Port 3240:         {GREEN}OPEN{RESET}" if st["port_active"] else f"Port 3240: {RED}CLOSED{RESET}")
            print(f"LAN IP:            {st['lan_ip']}")
            print(f"Devices detected:  {len(st['devices'])}")
    elif args.command == "start":
        start_service()
    elif args.command == "stop":
        stop_service()
    elif args.command == "restart":
        stop_service()
        time.sleep(1)
        start_service()
    elif args.command == "list":
        devs = list_devices()
        print(f"Discovered USB Peripherals ({len(devs)}):")
        for d in devs:
            print(f"  {d}")
    elif args.command == "share":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl share <busid>{RESET}")
            sys.exit(1)
        share_device(args.busid)
    elif args.command == "unshare":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl unshare <busid>{RESET}")
            sys.exit(1)
        unshare_device(args.busid)
    elif args.command == "policy":
        pol = load_policy()
        action = (args.busid or "").lower()
        target = args.extra or ""
        if not action or action == "show":
            print(f"{CYAN}═══ 🛡️ USBAnywhere Host Export Policy ═══{RESET}")
            print(f"Policy file:        {POLICY_FILE}")
            print(f"Allow all devices:  {GREEN}YES{RESET}" if pol.get("allow_all") else f"Allow all: {YELLOW}NO{RESET}")
            print(f"Protect local HID:  {GREEN}ACTIVE{RESET}" if pol.get("protect_local_hid") else f"Protect local HID: {DIM}OFF{RESET}")
            print(f"Allowlist ({len(pol.get('allowlist', []))}):   {pol.get('allowlist', [])}")
            print(f"Denylist ({len(pol.get('denylist', []))}):    {pol.get('denylist', [])}")
        elif action == "deny" and target:
            if target not in pol.get("denylist", []):
                pol.setdefault("denylist", []).append(target)
                save_policy(pol)
                print(f"{GREEN}✓ Added '{target}' to denylist.{RESET}")
        elif action == "allow" and target:
            if target not in pol.get("allowlist", []):
                pol.setdefault("allowlist", []).append(target)
                save_policy(pol)
                print(f"{GREEN}✓ Added '{target}' to allowlist.{RESET}")
        elif action == "remove" and target:
            changed = False
            if target in pol.get("denylist", []):
                pol["denylist"].remove(target)
                changed = True
            if target in pol.get("allowlist", []):
                pol["allowlist"].remove(target)
                changed = True
            if changed:
                save_policy(pol)
                print(f"{GREEN}✓ Removed '{target}' from policy lists.{RESET}")
            else:
                print(f"{YELLOW}Target '{target}' not found in policy lists.{RESET}")
        elif action == "protect-hid":
            flag = target.lower() in ["true", "1", "on", "yes"]
            pol["protect_local_hid"] = flag
            save_policy(pol)
            state = f"{GREEN}ENABLED{RESET}" if flag else f"{YELLOW}DISABLED{RESET}"
            print(f"✓ Local HID Protection is now {state}.")
        else:
            print(f"Usage:")
            print(f"  usbanywhere-ctl policy [show]")
            print(f"  usbanywhere-ctl policy deny <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy allow <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy remove <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy protect-hid <on|off>")
    elif args.command == "auto-unbind":
        run_auto_unbind_daemon()
    elif args.command == "dynamic-daemon":
        run_dynamic_daemon()
    elif args.command == "fix-dualsense":
        ok = apply_dualsense_fix()
        sys.exit(0 if ok else 1)
    elif args.command == "doctor":
        run_doctor()
    elif args.command == "test":
        ok = run_self_test()
        sys.exit(0 if ok else 1)
    elif args.command == "logs":
        if IS_MACOS:
            os.system("tail -f /var/log/usbanywhere-server.log")
        elif IS_LINUX:
            os.system("journalctl -u usbipd -f")
    elif args.command == "scan":
        scan_network_servers()
    elif args.command == "remote":
        if not args.busid:
            print(f"{RED}Error: Missing server IP. Usage: usbanywhere-ctl remote <server_ip>{RESET}")
            sys.exit(1)
        list_remote_devices(args.busid)
    elif args.command in ("connect", "attach"):
        if not args.busid or not args.extra:
            print(f"{RED}Error: Missing arguments. Usage: sudo usbanywhere-ctl connect <server_ip> <busid>{RESET}")
            sys.exit(1)
        ok = connect_remote_device(args.busid, args.extra)
        sys.exit(0 if ok else 1)
    elif args.command in ("disconnect", "detach"):
        ok = disconnect_remote_device(args.busid or "all")
        sys.exit(0 if ok else 1)
    elif args.command == "ports":
        list_client_ports()

if __name__ == "__main__":
    main()
