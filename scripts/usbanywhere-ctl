#!/usr/bin/env python3
"""
USBAnywhere Control Suite (macOS & Linux)
Unified management, interactive dashboard, and diagnostic tool for USBAnywhere Server.
Zero external dependencies. Works out-of-the-box on macOS (Apple Silicon & Intel) and Linux.

Copyright (c) 2025-2026 oscarlosu-lab - https://github.com/oscarlosu-lab/USBAnywhere-Server
Licensed under GPL v3
"""
import os
import sys
import platform
import subprocess
import socket
import struct
import time
import hmac
import json
import shutil
import re
import argparse
import threading

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8")

VERSION = "3.5.0-rc.1"
PORT = 3240
CONTROL_PORT = 3241

IS_MACOS = platform.system() == "Darwin"
IS_LINUX = platform.system() == "Linux"

# Terminal ANSI styling
GREEN = "\033[92m"
BLUE = "\033[94m"
CYAN = "\033[96m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
DIM = "\033[2m"
GUARD_COLOR = "\033[38;5;202m"
SERVER_COLOR = "\033[38;5;214m"
CLIENT_COLOR = "\033[38;5;157m"
RESET = "\033[0m"


POLICY_FILE = "/etc/usbanywhere/policy.json"
DEFAULT_POLICY = {
    "allow_all": True,
    "allowlist": [],
    "denylist": [],
    "protect_local_hid": False,
    "skip_classes": ["09"],
    "allowed_ips": [],
    "control_token": ""
}

def load_policy(path=POLICY_FILE):
    """Load host export policy from JSON configuration file."""
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
                pol = DEFAULT_POLICY.copy()
                pol.update(data)
                return pol
        except Exception:
            pass
    return DEFAULT_POLICY.copy()

def save_policy(pol, path=POLICY_FILE):
    """Save host export policy to JSON configuration file."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(pol, f, indent=2)
        return True
    except Exception as e:
        print(f"{RED}Error saving policy: {e}{RESET}")
        return False


def is_client_ip_allowed(client_ip, policy=None):
    """Check optional host IP allowlist (empty list allows any LAN client)."""
    if policy is None:
        policy = load_policy()
    allowed = [str(x).strip() for x in policy.get("allowed_ips", []) if str(x).strip()]
    if not allowed:
        return True
    ip = str(client_ip or "").strip()
    return ip in ("127.0.0.1", "::1") or ip in allowed

def parse_authenticated_command(parts, policy=None):
    """Verify optional control_token via constant-time HMAC comparison and return command tokens."""
    if policy is None:
        policy = load_policy()
    expected = str(policy.get("control_token", "") or "").strip()
    if not expected:
        return True, parts
    if len(parts) >= 3 and parts[0].upper() == "TOKEN":
        provided = parts[1]
        if hmac.compare_digest(provided.encode("utf-8"), expected.encode("utf-8")):
            return True, parts[2:]
    return False, []

def is_uas_device(busid):
    """Return True if any USB interface under sysfs busid is currently bound to the Linux uas driver."""
    if not IS_LINUX or not is_valid_busid(busid):
        return False
    dev_path = os.path.join("/sys/bus/usb/devices", busid.strip())
    if not os.path.isdir(dev_path):
        return False
    try:
        for item in os.listdir(dev_path):
            if item.startswith(f"{busid.strip()}:"):
                drv_link = os.path.join(dev_path, item, "driver")
                if os.path.islink(drv_link):
                    if os.path.basename(os.readlink(drv_link)) == "uas":
                        return True
    except Exception:
        pass
    return False

def is_valid_busid(busid):
    """Validate USB Bus ID format strictly to prevent path traversal and argument injection."""
    return bool(busid and isinstance(busid, str) and re.match(r"^\d+-[\d.]+$", busid.strip()))

def get_device_info(busid):
    """Inspect sysfs for a given busid on Linux and return (vid, pid, dev_class, if_classes, prod_name, mfg_name)."""
    if not IS_LINUX or not is_valid_busid(busid):
        return "", "", "", set(), "", ""
    dev_path = os.path.join("/sys/bus/usb/devices", busid.strip())
    if not os.path.exists(dev_path):
        return "", "", "", set(), "", ""
    
    vid, pid, dev_class = "", "", ""
    v_file = os.path.join(dev_path, "idVendor")
    d_file = os.path.join(dev_path, "idProduct")
    c_file = os.path.join(dev_path, "bDeviceClass")
    if os.path.isfile(v_file):
        try:
            with open(v_file, "r") as f: vid = f.read().strip().lower()
        except Exception: pass
    if os.path.isfile(d_file):
        try:
            with open(d_file, "r") as f: pid = f.read().strip().lower()
        except Exception: pass
    if os.path.isfile(c_file):
        try:
            with open(c_file, "r") as f: dev_class = f.read().strip().lower()
        except Exception: pass

    if_classes = set()
    try:
        for item in os.listdir(dev_path):
            if item.startswith(f"{busid}:"):
                if_cls_p = os.path.join(dev_path, item, "bInterfaceClass")
                if os.path.isfile(if_cls_p):
                    try:
                        with open(if_cls_p, "r") as f:
                            if_classes.add(f.read().strip().lower())
                    except Exception: pass
    except Exception: pass

    prod_name = ""
    p_file = os.path.join(dev_path, "product")
    if os.path.isfile(p_file):
        try:
            with open(p_file, "r") as f: prod_name = f.read().strip()
        except Exception: pass
    mfg_name = ""
    m_file = os.path.join(dev_path, "manufacturer")
    if os.path.isfile(m_file):
        try:
            with open(m_file, "r") as f: mfg_name = f.read().strip()
        except Exception: pass

    return vid, pid, dev_class, if_classes, prod_name, mfg_name

def is_device_export_allowed(busid, policy=None):
    """Check if device is allowed to be exported based on server export policy."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        return False, "Invalid BusId format"
    if policy is None:
        policy = load_policy()
    vid, pid, dev_class, if_classes, prod_name, mfg_name = get_device_info(busid)
    
    # Always prevent sharing USB Hubs (Class 09) and Linux Foundation root hubs
    if dev_class == "09" or "09" in if_classes or vid == "1d6b":
        return False, "USB Hubs cannot be shared"

    b_id = busid.lower().strip()
    vp = f"{vid}:{pid}".lower().strip() if (vid and pid) else ""

    # Denylist check (supports busid, vid:pid, or vid)
    denylist = [x.lower().strip() for x in policy.get("denylist", [])]
    if b_id in denylist or vp in denylist or (vid and vid in denylist):
        return False, f"Device {busid} ({vp}) is blocked by host denylist"

    # Local HID protection (protects local keyboards/mice/gamepads from remote grabbing)
    if policy.get("protect_local_hid", False):
        is_hid = (dev_class == "03" or "03" in if_classes or vid == "28de")
        if is_hid:
            return False, f"Device {busid} ({vp}) is protected local HID"

    # Allowlist check (if defined and non-empty)
    allowlist = [x.lower().strip() for x in policy.get("allowlist", [])]
    if allowlist:
        if not (b_id in allowlist or vp in allowlist or (vid and vid in allowlist)):
            return False, f"Device {busid} ({vp}) is not in host allowlist"

    return True, "OK"

# ══════════════════════════════════════════════════════════════════════════════
# HELPER UTILITIES
# ══════════════════════════════════════════════════════════════════════════════

def run_cmd(cmd, capture=True, check=False, timeout=30):
    """Run shell command safely without shell injection."""
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                             stderr=subprocess.PIPE if capture else None,
                             text=True, check=check, timeout=timeout)
        return res.stdout.strip() if capture else ""
    except Exception as e:
        if check:
            raise
        return ""

def run_cmd_result(cmd, timeout=30):
    """Run a command and return (returncode, stdout, stderr). returncode is None if it could not run."""
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, timeout=timeout)
        return res.returncode, (res.stdout or "").strip(), (res.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return None, "", f"timed out after {timeout}s"
    except Exception as e:
        return None, "", str(e)

def is_root():
    """Check if script is running with superuser privileges."""
    return os.geteuid() == 0 if hasattr(os, "geteuid") else False

def build_sudo_command(*args):
    """Build the argv used to re-run this script with sudo for one explicit subcommand."""
    return ["sudo", sys.executable, os.path.realpath(__file__), *[str(a) for a in args]]

def rerun_with_sudo(*args):
    """
    Re-run this script with sudo for one explicit subcommand (e.g. "connect", ip, busid).
    Never re-uses sys.argv: in the interactive dashboard sys.argv has no subcommand, so
    re-running it would just open a second dashboard and drop the requested action.
    """
    if not shutil.which("sudo"):
        print(f"{RED}[Error] 'sudo' not found. Run as root: usbanywhere-ctl {' '.join(str(a) for a in args)}{RESET}")
        return False
    sys.stdout.flush()
    try:
        return subprocess.run(build_sudo_command(*args)).returncode == 0
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Cancelled.{RESET}")
        return False
    except OSError as e:
        print(f"{RED}[Error] Could not run sudo: {e}{RESET}")
        return False

def get_lan_ip():
    """Find local LAN IPv4 address."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def is_port_open(host="127.0.0.1", port=PORT, timeout=1.0):
    """Check if USB/IP daemon is listening on TCP port."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        res = s.connect_ex((host, port))
        s.close()
        return res == 0
    except Exception:
        return False

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE CONTROLLERS (macOS launchd vs Linux systemd)
# ══════════════════════════════════════════════════════════════════════════════

def get_service_status():
    """Check background daemon status."""
    port_active = is_port_open()

    if IS_MACOS:
        plist_path = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        installed = os.path.exists(plist_path)
        out = run_cmd(["launchctl", "list"])
        running = "com.usbanywhere.server" in out
        return {
            "os": "macOS (Apple Silicon / Intel)",
            "service_manager": "launchd",
            "installed": installed,
            "running": running or port_active,
            "port_active": port_active
        }
    elif IS_LINUX:
        installed = os.path.exists("/etc/systemd/system/usbipd.service") or \
                    os.path.exists("/lib/systemd/system/usbipd.service")
        out = run_cmd(["systemctl", "is-active", "usbipd"])
        running = out == "active"
        return {
            "os": "Linux",
            "service_manager": "systemd",
            "installed": installed,
            "running": running or port_active,
            "port_active": port_active
        }
    else:
        return {
            "os": platform.system(),
            "service_manager": "unknown",
            "installed": False,
            "running": port_active,
            "port_active": port_active
        }

def start_service():
    """Start the USB/IP server service."""
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("start")

    if IS_MACOS:
        plist = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        if os.path.exists(plist):
            run_cmd(["launchctl", "load", "-w", plist])
            print(f"{GREEN}✓ macOS service started via launchd.{RESET}")
            return True
        else:
            print(f"{YELLOW}[!] Service plist not found. Running interactive daemon...{RESET}")
            subprocess.Popen(["usbanywhere-server-mac", "serve", "--auto-bind"])
            return True
    elif IS_LINUX:
        rc, _, err = run_cmd_result(["systemctl", "restart", "usbipd"])
        if rc != 0:
            print(f"{RED}✗ Failed to start usbipd via systemd: {err or f'exit code {rc}'}{RESET}")
            return False
        print(f"{GREEN}✓ Linux service started via systemd.{RESET}")
        return True
    return False

def stop_service():
    """Stop the USB/IP server service."""
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("stop")

    if IS_MACOS:
        plist = "/Library/LaunchDaemons/com.usbanywhere.server.plist"
        if os.path.exists(plist):
            run_cmd(["launchctl", "unload", "-w", plist])
        run_cmd(["pkill", "-f", "usbanywhere-server-mac"])
        print(f"{GREEN}✓ macOS service stopped.{RESET}")
        return True
    elif IS_LINUX:
        run_cmd(["systemctl", "stop", "usbipd"])
        run_cmd(["pkill", "-f", "usbipd"])
        print(f"{GREEN}✓ Linux service stopped.{RESET}")
        return True
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DEVICE INVENTORY (IOKit vs usbip / sysfs)
# ══════════════════════════════════════════════════════════════════════════════

def list_devices():
    """List local physical USB peripherals."""
    devices = []
    if IS_MACOS:
        # Use native macOS server CLI if installed
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "list", "--dynamic"])
            for line in out.splitlines():
                if ":" in line and line.strip():
                    devices.append(line.rstrip())
        else:
            # Fallback to system_profiler
            out = run_cmd(["system_profiler", "SPUSBDataType"])
            current = None
            for line in out.splitlines():
                line_str = line.strip()
                if line_str.endswith(":") and not any(k in line_str for k in ["Bus:", "Hub:", "Controller:"]):
                    current = line_str[:-1]
                elif "Product ID:" in line_str and current:
                    devices.append(f"• {current} ({line_str})")
                    current = None
    elif IS_LINUX:
        # 1. Direct sysfs scan for all physical USB peripherals (bound or unbound)
        sys_devs = "/sys/bus/usb/devices"
        if os.path.exists(sys_devs):
            for entry in sorted(os.listdir(sys_devs)):
                p = os.path.join(sys_devs, entry)
                v_file = os.path.join(p, "idVendor")
                d_file = os.path.join(p, "idProduct")
                if os.path.isfile(v_file) and os.path.isfile(d_file):
                    try:
                        with open(v_file, "r") as f:
                            vid = f.read().strip().lower()
                        with open(d_file, "r") as f:
                            pid = f.read().strip().lower()

                        cls_file = os.path.join(p, "bDeviceClass")
                        dev_class = ""
                        if os.path.isfile(cls_file):
                            with open(cls_file, "r") as f:
                                dev_class = f.read().strip().lower()

                        # Skip Hubs (Class 09) and Linux Foundation root hubs
                        if dev_class == "09" or vid == "1d6b" or entry.startswith("usb"):
                            continue

                        # Scan child interface classes for composite devices
                        if_classes = set()
                        for item in os.listdir(p):
                            if item.startswith(f"{entry}:"):
                                if_cls_p = os.path.join(p, item, "bInterfaceClass")
                                if os.path.isfile(if_cls_p):
                                    try:
                                        with open(if_cls_p, "r") as f:
                                            if_classes.add(f.read().strip().lower())
                                    except Exception:
                                        pass

                        prod_name = ""
                        p_file = os.path.join(p, "product")
                        if os.path.isfile(p_file):
                            with open(p_file, "r") as f:
                                prod_name = f.read().strip()
                        mfg_name = ""
                        m_file = os.path.join(p, "manufacturer")
                        if os.path.isfile(m_file):
                            with open(m_file, "r") as f:
                                mfg_name = f.read().strip()

                        # Valve Steam Controller special recognition
                        is_steam = (vid == "28de" and pid in ["1304", "1102", "1142", "11ff", "1205"])
                        if is_steam and not prod_name:
                            prod_name = "Steam Controller Wireless Receiver" if pid == "1304" else "Steam Controller"

                        # Determine functional class tag
                        tag = ""
                        if "03" in if_classes or dev_class == "03":
                            tag = " [HID/Gamepad]" if (is_steam or "gamepad" in prod_name.lower()) else " [HID]"
                        elif "08" in if_classes or dev_class == "08":
                            tag = " [Storage/UAS]" if is_uas_device(entry) else " [Storage]"
                        elif "0e" in if_classes or dev_class == "0e":
                            tag = " [Video]"
                        elif "01" in if_classes or dev_class == "01":
                            tag = " [Audio]"

                        desc = f"{mfg_name} {prod_name}".strip() or "USB Device"
                        devices.append(f"  {entry}    : {desc}{tag} ({vid}:{pid})")
                    except Exception:
                        pass
        if not devices:
            bin_path = shutil.which("usbip")
            if bin_path:
                out = run_cmd([bin_path, "list", "-l"])
                curr_bus = None
                for line in out.splitlines():
                    if "busid" in line:
                        m = re.search(r"busid\s+([0-9a-zA-Z\-\.]+)\s+\((.*?)\)", line)
                        if m:
                            curr_bus = m.group(1)
                            desc = m.group(2)
                            devices.append(f"  {curr_bus}    : {desc}")
            else:
                out = run_cmd(["lsusb"])
                for line in out.splitlines():
                    if line.strip():
                        devices.append(line.strip())
    return devices

_busid_locks = {}
_busid_locks_guard = threading.Lock()
_last_bind_error = {}

def _get_busid_lock(busid):
    with _busid_locks_guard:
        lock = _busid_locks.get(busid)
        if lock is None:
            lock = threading.Lock()
            _busid_locks[busid] = lock
        return lock

def _wait_udev_settle(timeout=3):
    udevadm = shutil.which("udevadm")
    if udevadm:
        run_cmd([udevadm, "settle", f"--timeout={timeout}"], timeout=timeout + 2)

def _get_usbip_host_status(busid):
    status_file = f"/sys/bus/usb/drivers/usbip-host/{busid}/usbip_status"
    if not os.path.isfile(status_file):
        return None
    try:
        with open(status_file, "r", encoding="utf-8") as f:
            raw = f.read().strip()
        return int(raw) if raw.isdigit() else None
    except Exception:
        return None

def _share_device_linux(busid, bin_path):
    dev_sysfs = f"/sys/bus/usb/devices/{busid}"
    with _get_busid_lock(busid):
        _last_bind_error.pop(busid, None)
        _wait_udev_settle(2)

        if not os.path.exists(dev_sysfs):
            _last_bind_error[busid] = f"Device {busid} not found on USB bus"
            print(f"{RED}✗ Device {busid} not found on USB bus.{RESET}")
            return False

        st = _get_usbip_host_status(busid)
        if st == 1:
            print(f"{GREEN}✓ Device {busid} already bound via usbip.{RESET}")
            return True

        # Wait briefly if a previous disconnect cleanup / auto-unbind is settling
        if st in (2, 3):
            deadline = time.monotonic() + 4.5
            while time.monotonic() < deadline and st in (2, 3):
                time.sleep(0.25)
                if not os.path.exists(dev_sysfs):
                    _last_bind_error[busid] = f"Device {busid} disconnected during cleanup"
                    print(f"{RED}✗ Device {busid} disconnected during cleanup.{RESET}")
                    return False
                st = _get_usbip_host_status(busid)
                if st == 1:
                    print(f"{GREEN}✓ Device {busid} bound via usbip.{RESET}")
                    return True

            if st == 3:
                try:
                    subprocess.run([bin_path, "unbind", "-b", busid], capture_output=True, text=True, timeout=15)
                except Exception:
                    pass
                _wait_udev_settle(2)
                st = _get_usbip_host_status(busid)

            if st == 2:
                _last_bind_error[busid] = f"Device {busid} is busy while finishing prior disconnect"
                print(f"{YELLOW}[!] Device {busid} still releasing prior client session.{RESET}")
                return False

        try:
            res = subprocess.run([bin_path, "bind", "-b", busid], capture_output=True, text=True, timeout=15)
        except Exception as e:
            _last_bind_error[busid] = f"usbip bind execution failed: {e}"
            print(f"{RED}✗ Failed binding {busid}: {e}{RESET}")
            return False

        # Verify in sysfs that usbip-host actually owns the device in SDEV_ST_AVAILABLE (1)
        deadline = time.monotonic() + 3.0
        while time.monotonic() < deadline:
            if not os.path.exists(dev_sysfs):
                _last_bind_error[busid] = f"Device {busid} disappeared before bind completed"
                print(f"{RED}✗ Device {busid} disappeared before bind completed.{RESET}")
                return False
            if _get_usbip_host_status(busid) == 1:
                out_msg = (res.stdout or "").strip()
                print(out_msg or f"{GREEN}✓ Device {busid} bound via usbip.{RESET}")
                return True
            time.sleep(0.15)

        err_text = (res.stderr or res.stdout or "").strip()
        if not err_text:
            err_text = f"usbip bind failed (exit={res.returncode}, status={_get_usbip_host_status(busid)})"
        _last_bind_error[busid] = err_text
        print(f"{RED}✗ Failed binding {busid}: {err_text}{RESET}")
        return False

def share_device(busid):
    """Export a specific USB peripheral by bus ID."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        print(f"{RED}[Error] Invalid Bus ID format: {busid}{RESET}")
        return False

    allowed, reason = is_device_export_allowed(busid)
    if not allowed:
        print(f"{RED}[Policy Block] Cannot share {busid}: {reason}{RESET}")
        return False

    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("share", busid)

    if IS_MACOS:
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "bind", busid])
            print(out or f"{GREEN}✓ Device {busid} shared.{RESET}")
            return True
    elif IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            return _share_device_linux(busid, bin_path)
    return False

def unshare_device(busid):
    """Unshare a USB peripheral by bus ID."""
    if not re.match(r"^\d+-[\d.]+$", str(busid or "")):
        print(f"{RED}[Error] Invalid Bus ID format: {busid}{RESET}")
        return False

    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("unshare", busid)

    if IS_MACOS:
        bin_path = shutil.which("usbanywhere-server-mac")
        if bin_path:
            out = run_cmd([bin_path, "unbind", busid])
            print(out or f"{GREEN}✓ Device {busid} unbound.{RESET}")
            return True
    elif IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            with _get_busid_lock(busid):
                if _get_usbip_host_status(busid) is None:
                    print(f"{GREEN}✓ Device {busid} already unbound.{RESET}")
                    return True
                try:
                    res = subprocess.run([bin_path, "unbind", "-b", busid], capture_output=True, text=True, timeout=15)
                except Exception as e:
                    print(f"{RED}✗ Failed unbinding {busid}: {e}{RESET}")
                    return False

                deadline = time.monotonic() + 3.0
                while time.monotonic() < deadline and _get_usbip_host_status(busid) is not None:
                    time.sleep(0.15)
                _wait_udev_settle(2)

                if _get_usbip_host_status(busid) is None:
                    out_msg = (res.stdout or "").strip()
                    print(out_msg or f"{GREEN}✓ Device {busid} unbound via usbip.{RESET}")
                    return True
                err_text = (res.stderr or res.stdout or "").strip()
                print(f"{RED}✗ Failed unbinding {busid}: {err_text}{RESET}")
                return False
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DYNAMIC AUTO-UNBIND & CONTROL API (Zero-Host-Lockout)
# ══════════════════════════════════════════════════════════════════════════════

def run_auto_unbind_daemon(interval=0.5, standalone=True):
    """
    Dynamic Auto-Unbind Watcher:
    Monitors /sys/bus/usb/drivers/usbip-host/*/usbip_status on Linux.
    When a remote client disconnects (SDEV_ST_USED [2] -> SDEV_ST_AVAILABLE [1])
    or hits transport error (SDEV_ST_ERROR [3]), automatically unbinds the peripheral
    so the local OS reclaims it promptly without manual intervention.
    """
    if standalone:
        print(f"\n{CYAN}═══ 🔄 USBAnywhere Dynamic Auto-Unbind Daemon ═══{RESET}")
        print(f"Monitoring USB/IP client disconnects (Poll interval: {interval}s)...")
    
    prev_statuses = {}
    
    while True:
        try:
            if IS_LINUX:
                sysfs_base = "/sys/bus/usb/drivers/usbip-host"
                if os.path.exists(sysfs_base):
                    entries = [e for e in os.listdir(sysfs_base) if re.match(r"^\d+-[\d.]+$", e)]
                    current_set = set(entries)
                    for stale in list(prev_statuses.keys()):
                        if stale not in current_set:
                            prev_statuses.pop(stale, None)

                    for entry in entries:
                        status_code = _get_usbip_host_status(entry)
                        if status_code is None:
                            continue

                        prev = prev_statuses.get(entry)
                        # 2 = SDEV_ST_USED, 1 = SDEV_ST_AVAILABLE, 3 = SDEV_ST_ERROR
                        if (prev == 2 and status_code == 1) or status_code == 3:
                            print(f"{YELLOW}[Auto-Unbind] Releasing device {entry} (status {prev} -> {status_code}).{RESET}")
                            unshare_device(entry)
                            prev_statuses.pop(entry, None)
                            continue

                        prev_statuses[entry] = status_code
                else:
                    prev_statuses.clear()
            elif IS_MACOS:
                bin_path = shutil.which("usbanywhere-server-mac")
                if bin_path:
                    out = run_cmd([bin_path, "status", "--json"])
                    if out:
                        try:
                            data = json.loads(out)
                            for dev in data.get("devices", []):
                                bid = dev.get("busid")
                                clients = dev.get("connected_clients", 0)
                                prev_c = prev_statuses.get(bid, 0)
                                if prev_c > 0 and clients == 0:
                                    print(f"{YELLOW}[Auto-Unbind] Client disconnected from {bid}. Auto-releasing...{RESET}")
                                    unshare_device(bid)
                                prev_statuses[bid] = clients
                        except Exception:
                            pass
            time.sleep(interval)
        except KeyboardInterrupt:
            if standalone:
                print(f"\n{YELLOW}Auto-unbind daemon stopped.{RESET}")
            break
        except Exception:
            time.sleep(interval)

def handle_control_client(sock, addr):
    """Handle incoming on-demand control command (TCP 3241)."""
    try:
        sock.settimeout(5.0)
        data = sock.recv(1024).decode("utf-8").strip()
        if not data:
            sock.close()
            return
        
        client_ip = addr[0] if addr else ""
        pol_auth = load_policy()
        if not is_client_ip_allowed(client_ip, pol_auth):
            resp = json.dumps({"status": "DENIED", "message": f"Client IP {client_ip} is not in host allowlist"}) + "\n"
            sock.sendall(resp.encode("utf-8"))
            return
        raw_parts = data.split()
        auth_ok, parts = parse_authenticated_command(raw_parts, pol_auth)
        if not auth_ok or not parts:
            resp = json.dumps({"status": "DENIED", "message": "Invalid or missing control token"}) + "\n"
            sock.sendall(resp.encode("utf-8"))
            return
        cmd = parts[0].upper()
        
        if cmd == "LIST":
            devs = list_devices()
            resp = json.dumps({"status": "OK", "devices": devs}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "BIND" and len(parts) > 1:
            target_bus = parts[1]
            if not re.match(r"^\d+-[\d.]+$", target_bus):
                resp = json.dumps({"status": "ERROR", "busid": target_bus, "action": "bind", "message": "Invalid BusId"}) + "\n"
                sock.sendall(resp.encode("utf-8"))
                return
            allowed, reason = is_device_export_allowed(target_bus)
            if not allowed:
                resp = json.dumps({"status": "DENIED", "busid": target_bus, "action": "bind", "message": reason}) + "\n"
                sock.sendall(resp.encode("utf-8"))
            else:
                ok = share_device(target_bus)
                payload = {"status": "OK" if ok else "ERROR", "busid": target_bus, "action": "bind"}
                if not ok:
                    payload["message"] = _last_bind_error.get(target_bus, f"Failed to bind {target_bus}")
                resp = json.dumps(payload) + "\n"
                sock.sendall(resp.encode("utf-8"))
        elif cmd == "POLICY":
            pol = dict(load_policy())
            pol["control_token"] = "***" if pol.get("control_token") else ""
            resp = json.dumps({"status": "OK", "policy": pol}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "UNBIND" and len(parts) > 1:
            target_bus = parts[1]
            if not re.match(r"^\d+-[\d.]+$", target_bus):
                resp = json.dumps({"status": "ERROR", "busid": target_bus, "action": "unbind", "message": "Invalid BusId"}) + "\n"
                sock.sendall(resp.encode("utf-8"))
                return
            ok = unshare_device(target_bus)
            resp = json.dumps({"status": "OK" if ok else "ERROR", "busid": target_bus, "action": "unbind"}) + "\n"
            sock.sendall(resp.encode("utf-8"))
        elif cmd == "STATUS":
            st = get_service_status()
            resp = json.dumps(st) + "\n"
            sock.sendall(resp.encode("utf-8"))
        else:
            sock.sendall(b'{"status": "ERROR", "message": "Unknown command"}\n')
    except Exception as e:
        try:
            err_resp = json.dumps({"status": "ERROR", "message": str(e)}) + "\n"
            sock.sendall(err_resp.encode("utf-8"))
        except Exception:
            pass
    finally:
        try:
            sock.close()
        except Exception:
            pass

def run_udp_discovery_responder(port=CONTROL_PORT):
    """Listen for incoming UDP discovery probes on port 3241 and reply with server identity."""
    try:
        udp_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if hasattr(socket, "SO_BROADCAST"):
            udp_sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        udp_sock.bind(("0.0.0.0", port))
        
        while True:
            try:
                data, addr = udp_sock.recvfrom(1024)
                msg = data.decode("utf-8", errors="ignore").strip()
                if "USBANYWHERE_DISCOVERY_PROBE" in msg or "DISCOVERY" in msg:
                    host = socket.gethostname()
                    resp = f"USBANYWHERE_SERVER:{host}\n".encode("utf-8")
                    udp_sock.sendto(resp, addr)
            except Exception:
                time.sleep(0.05)
    except Exception:
        pass

def run_dynamic_daemon(port=CONTROL_PORT):
    """Run dynamic daemon with both background auto-unbind watcher and on-demand control listener."""
    import threading
    
    print(f"\n{CYAN}═══ ⚡ USBAnywhere Dynamic Multi-Tenant Daemon ═══{RESET}")
    print(f"• Dynamic Auto-Unbind: ACTIVE (Devices released to local OS when client disconnects)")
    print(f"• Control Socket:      LISTENING on TCP port {port} (On-demand BIND / UNBIND API)")
    print(f"• Discovery Responder: LISTENING on UDP port {port} (Broadcast Auto-Scan Responder)")
    print(f"• Main USB/IP Port:    LISTENING on TCP port {PORT}")
    
    watcher_t = threading.Thread(target=run_auto_unbind_daemon, kwargs={"interval": 0.5, "standalone": False}, daemon=True)
    watcher_t.start()

    udp_t = threading.Thread(target=run_udp_discovery_responder, kwargs={"port": port}, daemon=True)
    udp_t.start()
    
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("0.0.0.0", port))
        srv.listen(5)
    except Exception as e:
        print(f"{RED}Error binding to control port {port}: {e}{RESET}")
        return
        
    try:
        while True:
            client_sock, addr = srv.accept()
            threading.Thread(target=handle_control_client, args=(client_sock, addr), daemon=True).start()
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Dynamic daemon stopped.{RESET}")
    finally:
        srv.close()

# ══════════════════════════════════════════════════════════════════════════════
# DIAGNOSTICS & SELF-TEST
# ══════════════════════════════════════════════════════════════════════════════

def run_self_test(host="127.0.0.1", port=PORT):
    """Run binary loopback protocol handshake test."""
    print(f"\n{CYAN}═══ 🧪 USBAnywhere Binary Protocol Self-Test ═══{RESET}")
    print(f"Connecting to {host}:{port}...")

    s = None
    for attempt in range(1, 4):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(3.0)
            s.connect((host, port))
            print(f"{GREEN}✓ TCP Connection established on port {port}{RESET}")
            break
        except Exception as e:
            time.sleep(0.5)
            if attempt == 3:
                print(f"{RED}✗ FAILED: Could not connect to port {port} ({e}){RESET}")
                return False

    try:
        # Send OP_REQ_DEVLIST (0x0111, 0x8005, 0x00000000)
        req = struct.pack(">HHI", 0x0111, 0x8005, 0)
        s.sendall(req)

        header = s.recv(8)
        if len(header) < 8:
            print(f"{RED}✗ FAILED: Expected 8 header bytes, received {len(header)}{RESET}")
            s.close()
            return False

        version, cmd, status = struct.unpack(">HHI", header)
        print(f"Received Header: Version=0x{version:04X}, Cmd=0x{cmd:04X}, Status={status}")

        if version == 0x0111 and cmd == 0x0005 and status == 0:
            ndev_bytes = s.recv(4)
            ndev = struct.unpack(">I", ndev_bytes)[0] if len(ndev_bytes) == 4 else 0
            print(f"{GREEN}✓ USB/IP OP_REP_DEVLIST valid! Exported devices: {ndev}{RESET}")
            s.close()
            print(f"{GREEN}✓ PROTOCOL SELF-TEST PASSED: Server is fully operational!{RESET}\n")
            return True
        else:
            print(f"{RED}✗ FAILED: Protocol header mismatch.{RESET}")
            s.close()
            return False
    except Exception as e:
        print(f"{RED}✗ FAILED with exception: {e}{RESET}")
        if s: s.close()
        return False

def run_doctor():
    """System health check and diagnostic inspection."""
    print(f"\n{BOLD}{CYAN}═══ 🩺 USBAnywhere System Doctor ═══{RESET}\n")

    # 1. OS & Kernel
    os_name = platform.system()
    arch = platform.machine()
    print(f"• Operating System:   {BOLD}{os_name} ({arch}){RESET}")
    print(f"• Kernel Version:     {platform.release()}")

    # 2. Permissions
    root = is_root()
    root_str = f"{GREEN}YES (root){RESET}" if root else f"{YELLOW}NO (standard user){RESET}"
    print(f"• Superuser Privs:    {root_str}")

    # 3. Port & Service
    st = get_service_status()
    srv_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
    port_str = f"{GREEN}LISTENING (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"
    print(f"• Service Status:     {srv_str} (via {st['service_manager']})")
    print(f"• Network Listener:   {port_str}")
    print(f"• Local LAN IPv4:     {CYAN}{get_lan_ip()}{RESET}")

    # 4. Kernel Modules (Linux only)
    if IS_LINUX:
        lsmod = run_cmd(["lsmod"])
        has_core = "usbip_core" in lsmod
        has_host = "usbip_host" in lsmod
        core_str = f"{GREEN}LOADED{RESET}" if has_core else f"{RED}MISSING (run: sudo modprobe usbip_core){RESET}"
        host_str = f"{GREEN}LOADED{RESET}" if has_host else f"{RED}MISSING (run: sudo modprobe usbip_host){RESET}"
        print(f"• Kernel Module core: {core_str}")
        print(f"• Kernel Module host: {host_str}")
        has_vhci = "vhci_hcd" in lsmod or os.path.exists("/sys/devices/platform/vhci_hcd.0")
        vhci_str = f"{GREEN}LOADED{RESET}" if has_vhci else f"{DIM}not loaded (client only; loaded automatically on connect){RESET}"
        print(f"• Kernel Module vhci: {vhci_str}")

        # Check Raspberry Pi legacy dwc_otg driver (causes kernel Oops in stub_send_ret_submit behind USB 2.0 Hub HATs)
        if os.path.exists("/sys/bus/platform/drivers/dwc_otg") and any(
            x.startswith("20980000.usb") or x.startswith("3f980000.usb") or x.startswith("fe980000.usb")
            for x in os.listdir("/sys/bus/platform/drivers/dwc_otg")
        ):
            print(f"• RPi USB Controller: {YELLOW}WARNING: Legacy 'dwc_otg' active!{RESET}")
            print(f"    {YELLOW}↳ High-speed HID/DualSense behind USB 2.0 Hub HATs may trigger a kernel Oops.{RESET}")
            print(f"    {CYAN}↳ Fix: Run 'sudo usbanywhere-ctl fix-dualsense' or add 'dtoverlay=dwc2,dr_mode=host' to /boot/firmware/config.txt{RESET}")
        elif os.path.exists("/sys/bus/platform/drivers/dwc2"):
            print(f"• RPi USB Controller: {GREEN}dwc2 (Modern split-transaction safe){RESET}")

        dualsense_rule = "/etc/udev/rules.d/99-usbanywhere-dualsense-fix.rules"
        if os.path.exists(dualsense_rule):
            print(f"• DualSense Quirk:    {GREEN}INSTALLED ({dualsense_rule}){RESET}")

    # 5. Device Inventory
    devs = list_devices()
    print(f"• USB Devices Found:  {BOLD}{len(devs)}{RESET}")
    for d in devs[:5]:
        print(f"    {DIM}{d}{RESET}")
    if len(devs) > 5:
        print(f"    {DIM}... and {len(devs) - 5} more{RESET}")

    print(f"\n{GREEN}Doctor completed.{RESET}\n")

# ══════════════════════════════════════════════════════════════════════════════
# INTERACTIVE DASHBOARD / TUI
# ══════════════════════════════════════════════════════════════════════════════

CANCEL_WORDS = ("q", "quit", "exit", "cancel")

class PromptCancelled(Exception):
    """Raised when the user cancels an interactive prompt (q, empty input, Ctrl+C or Ctrl+D)."""

def ask(prompt_text):
    """input() that turns Ctrl+C, Ctrl+D and cancel words into PromptCancelled."""
    try:
        value = input(prompt_text).strip()
    except (KeyboardInterrupt, EOFError):
        print()
        raise PromptCancelled()
    if value.lower() in CANCEL_WORDS:
        raise PromptCancelled()
    return value

def pause(message="Press Enter to return to Dashboard..."):
    """Wait for Enter so the user can read the output before the screen is cleared."""
    try:
        input(f"\n{DIM}{message}{RESET}")
    except (KeyboardInterrupt, EOFError):
        print()

def choose_item(label, items, validator, free_text_hint):
    """
    Let the user pick one of `items` by its number, or type a value accepted by `validator`.
    `items` may contain None for entries that cannot be selected by number.
    Raises PromptCancelled on empty input, q, Ctrl+C or Ctrl+D.
    """
    selectable = any(items)
    if selectable:
        choices = "1" if len(items) == 1 else f"1-{len(items)}"
        prompt_text = f"Select {label} [{choices}] or type {free_text_hint} (q to cancel): "
    else:
        prompt_text = f"Enter {free_text_hint} (q to cancel): "
    while True:
        value = ask(prompt_text)
        if not value:
            raise PromptCancelled()
        if value.isdigit():
            n = int(value)
            if selectable and 1 <= n <= len(items) and items[n - 1]:
                return items[n - 1]
            if selectable and 1 <= n <= len(items):
                print(f"{YELLOW}Entry {n} has no usable {label} identifier; type it instead.{RESET}")
            elif selectable:
                print(f"{YELLOW}Invalid number. Choose between 1 and {len(items)}.{RESET}")
            else:
                print(f"{YELLOW}Nothing to select by number; type {free_text_hint}.{RESET}")
            continue
        if validator(value):
            return value
        print(f"{YELLOW}Invalid {label}: {value}{RESET}")

ROLES = ("server", "client", "both")
ROLE_LABELS = {"server": f"{SERVER_COLOR}Server{RESET}",
               "client": f"{CLIENT_COLOR}Client{RESET}",
               "both": f"{SERVER_COLOR}Server{RESET} + {CLIENT_COLOR}Client{RESET}"}

def _role_config_path():
    """Per-user config file. Under sudo it still points to the invoking user's home."""
    home = None
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and is_root():
        try:
            import pwd
            home = pwd.getpwnam(sudo_user).pw_dir
        except Exception:
            home = None
    return os.path.join(home or os.path.expanduser("~"), ".config", "usbanywhere", "ctl.json")

def load_role():
    """Return the saved dashboard role ('server', 'client' or 'both'), or None."""
    try:
        with open(_role_config_path(), "r", encoding="utf-8") as f:
            role = json.load(f).get("role")
        return role if role in ROLES else None
    except Exception:
        return None

def save_role(role):
    """Persist the dashboard role. When running under sudo, keep the file owned by the real user."""
    path = _role_config_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"role": role}, f, indent=2)
        uid, gid = os.environ.get("SUDO_UID"), os.environ.get("SUDO_GID")
        if is_root() and uid and gid and uid.isdigit() and gid.isdigit():
            for p in (os.path.dirname(path), path):
                os.chown(p, int(uid), int(gid))
        return True
    except Exception as e:
        print(f"{YELLOW}[!] Could not save role to {path}: {e}{RESET}")
        return False

def suggest_role():
    """Default role: 'both' when the USB/IP server service is installed here, otherwise 'client'."""
    return "both" if get_service_status().get("installed") else "client"

def ask_role(current=None):
    """Ask how this computer is used. Returns the chosen role (or `current` if cancelled)."""
    default = current or suggest_role()
    default_idx = ROLES.index(default) + 1
    print(f"""
{BOLD}How will you use USBAnywhere on this computer?{RESET}
  {BOLD}{SERVER_COLOR}[1] Server{RESET}  — share this computer's USB devices with other computers
  {BOLD}{CLIENT_COLOR}[2] Client{RESET}  — use USB devices shared by another computer
  {BOLD}[3]{RESET} {BOLD}Both{RESET}
""")
    while True:
        try:
            value = input(f"{BOLD}Select [1-3] (Enter = {default_idx}): {RESET}").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print()
            if current:
                return current
            sys.exit(0)
        if not value:
            return default
        if value in ("1", "2", "3"):
            return ROLES[int(value) - 1]
        if value in ROLES:
            return value
        print(f"{YELLOW}Invalid option.{RESET}")

def offer_sudo_relaunch(role="both"):
    """When the dashboard is opened without root, offer to relaunch it with sudo."""
    if is_root() or not (IS_LINUX or IS_MACOS) or not sys.stdin.isatty() or not shutil.which("sudo"):
        return
    needs = []
    if role in ("server", "both"):
        needs.append("starting/stopping the service and sharing devices")
    if role in ("client", "both"):
        needs.append("connecting/detaching remote USB devices")
    print(f"{YELLOW}[!] Running as a standard user: {' and '.join(needs)} require superuser privileges.{RESET}")
    try:
        answer = input(f"{BOLD}Relaunch the Control Suite with sudo now? [Y/n]: {RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print()
        sys.exit(0)
    if answer not in ("", "y", "yes", "s", "si", "sí"):
        return
    try:
        # 'sudo -n true' succeeds silently with NOPASSWD rules; 'sudo -v' alone would still
        # ask for a password unless *every* matching sudoers entry is NOPASSWD (verifypw=all).
        no_pw = subprocess.run(["sudo", "-n", "true"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL).returncode == 0
        if not no_pw and subprocess.run(["sudo", "-v"]).returncode != 0:
            print(f"{YELLOW}sudo authentication failed. Continuing as standard user.{RESET}")
            time.sleep(1.5)
            return
        cmd = build_sudo_command("dashboard")
        os.execvp(cmd[0], cmd)
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Continuing as standard user.{RESET}")
        time.sleep(1)
    except OSError as e:
        print(f"{RED}[Error] Could not relaunch with sudo: {e}{RESET}")
        time.sleep(1.5)

def get_attached_ports():
    """Return (ports, error) without printing. ports is None if 'usbip' is unavailable and nothing is attached."""
    entries, err = read_client_ports()
    if not entries and not shutil.which("usbip"):
        return None, None
    return entries, err

class DashboardGuard:
    """Own a temporary guard through a pipe; EOF also handles a crashed dashboard."""
    def __init__(self):
        self.process = None

    def active(self):
        return self.process is not None and self.process.poll() is None

    def stop(self):
        if self.process is not None:
            if self.process.stdin:
                try:
                    self.process.stdin.close()
                except OSError:
                    pass
            try:
                self.process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                print(f"{RED}Temporary guard has not stopped yet; check the journal.{RESET}")
                return False
            self.process = None
        return True

    def start(self):
        if self.active():
            return True
        cmd = [sys.executable, os.path.realpath(__file__), "client-guard", "session"]
        if not is_root():
            if not shutil.which("sudo"):
                return False
            if subprocess.run(["sudo", "-n", "true"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode != 0:
                if subprocess.run(["sudo", "-v"]).returncode != 0:
                    return False
            cmd = ["sudo", "-n", *cmd]
        before = ClientSleepGuard.inhibitor_pids()
        self.process = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                        stdout=subprocess.DEVNULL, start_new_session=True)
        for _ in range(40):
            if not self.active():
                self.stop()
                return False
            if ClientSleepGuard.inhibitor_pids() - before:
                return True
            time.sleep(0.2)
        self.stop()
        return False


def render_dashboard(role=None):
    temporary = DashboardGuard()
    try:
        _render_dashboard(role, temporary)
    finally:
        temporary.stop()


def _render_dashboard(role, temporary):
    """Interactive Control Suite Terminal Dashboard, split into Server and Client sections."""
    role = role if role in ROLES else "both"
    while True:
        # Clear screen
        os.system("clear" if os.name != "nt" else "cls")

        is_server = role in ("server", "both")
        is_client = role in ("client", "both")
        lan_ip = get_lan_ip()
        st = get_service_status()
        devs = list_devices() if is_server else []
        ports, ports_err = get_attached_ports() if (is_client and IS_LINUX) else (None, None)
        privs = f"{GREEN}root{RESET}" if is_root() else f"{YELLOW}standard user (sudo will be requested){RESET}"

        print(f"""
{CYAN}╔══════════════════════════════════════════════════════════════════════════════╗
║                 🎛️  {BOLD}USBAnywhere Control Suite v{VERSION}{RESET}{CYAN}                         ║
║   Share local USB peripherals over network (Moonlight/Sunshine/Sim/Work)     ║
╚══════════════════════════════════════════════════════════════════════════════╝{RESET}
  • {BOLD}OS:{RESET} {st['os']}  |  {BOLD}LAN IP:{RESET} {BOLD}{GREEN}{lan_ip}{RESET}
  • {BOLD}Mode:{RESET} {BOLD}{ROLE_LABELS[role]}{RESET}  |  {BOLD}Privileges:{RESET} {privs}""")

        if is_server:
            status_badge = f"{GREEN}● ACTIVE{RESET}" if st["running"] else f"{RED}○ STOPPED{RESET}"
            port_badge = f"{GREEN}OPEN (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"
            print(f"""
{SERVER_COLOR}══════════════ 🖥️  SERVER — share this computer's USB devices ══════════════{RESET}
  • {BOLD}Server Daemon:{RESET} {status_badge} ({st['service_manager']})  |  {BOLD}Port 3240:{RESET} {port_badge}
  • Clients connect to {BOLD}{GREEN}{lan_ip}{RESET} (enter this IP in the USBAnywhere client)

  {BOLD}📋 Local USB Peripherals ({len(devs)}):{RESET}""")
            if not devs:
                print(f"    {YELLOW}No USB devices discovered or permission required.{RESET}")
            else:
                for idx, d in enumerate(devs[:8], start=1):
                    print(f"    {BOLD}#{idx}{RESET}  {d.strip()}")
                if len(devs) > 8:
                    print(f"    {DIM}... ({len(devs) - 8} more devices){RESET}")
            print(f"""
  {BOLD}[1]{RESET} Start / Restart Service       {BOLD}[3]{RESET} Share a USB Device
  {BOLD}[2]{RESET} Stop Service                  {BOLD}[4]{RESET} Unshare a USB Device
  {BOLD}[6]{RESET} Protocol Self-Test            {BOLD}[7]{RESET} View Live Logs""")

        if is_client:
            print(f"""
{CLIENT_COLOR}══════════════ 💻 CLIENT — use USB devices from another computer ══════════════{RESET}""")
            if not IS_LINUX:
                print(f"  {YELLOW}Client mode (vhci_hcd attach) is only supported on Linux.{RESET}")
            elif ports is None:
                print(f"  {YELLOW}'usbip' binary not found: install usbip / linux-tools to use client mode.{RESET}")
            else:
                if ports_err:
                    print(f"  {RED}[!] Could not read attached ports reliably: {ports_err}{RESET}")
                print(f"  {BOLD}🔌 Remote USB devices attached here ({len(ports)}):{RESET}")
                if not ports and not ports_err:
                    print(f"    {DIM}None. Use [9] to connect one.{RESET}")
                for e in ports:
                    remote_str = f"{e['ip']}/{e['busid']}" if e["ip"] or e["busid"] else "remote"
                    print(f"    • Port {BOLD}{e['port']}{RESET}: {remote_str} — {e['desc']}")
            print(f"""
  {BOLD}[9]{RESET} Connect Remote USB            {BOLD}[0]{RESET} Detach Remote USB""")
            if IS_LINUX:
                guard = run_cmd(["systemctl", "is-active", GUARD_UNIT], timeout=5) if shutil.which("systemctl") else ""
                print(f"\n{GUARD_COLOR}────────────── SLEEP PROTECTION (optional) ──────────────{RESET}")
                mode = "temporary — until this menu closes" if temporary.active() else (
                    "background service" if guard == "active" else "disabled")
                color = GREEN if temporary.active() or guard == "active" else GUARD_COLOR
                print(f"  {BOLD}{GUARD_COLOR}[g] Client guard mode{RESET}: {color}{mode}{RESET}")

        print(f"""
{CYAN}══════════════════════════════════════════════════════════════════════════════{RESET}
  {BOLD}{CYAN}[m] Change mode: Server / Client / Both{RESET}
  {BOLD}[5]{RESET} Health Doctor   {BOLD}[8]{RESET} Refresh   {BOLD}[q]{RESET} Quit
""")

        valid = ["5", "8", "m"] + (["1", "2", "3", "4", "6", "7"] if is_server else []) + (["9", "0"] if is_client else [])
        if is_client and IS_LINUX:
            valid.append("g")
        keys = "0-9" if (is_server and is_client) else ", ".join(sorted(k for k in valid if k.isdigit()))
        keys += (", g" if "g" in valid else "") + ", m, q"
        try:
            choice = input(f"{BOLD}Select an action [{keys}]: {RESET}").strip().lower()
        except (KeyboardInterrupt, EOFError):
            choice = "q"
            print()

        if choice in CANCEL_WORDS:
            print(f"\n{GREEN}Exiting USBAnywhere Control Suite. Have a great day!{RESET}\n")
            break
        if choice not in valid:
            continue

        local_busids = [extract_busid(d) for d in devs[:8]]
        try:
            if choice == "m":
                new_role = ask_role(role)
                if new_role != role:
                    role = new_role
                    save_role(role)
            elif choice == "g":
                print(f"  {GUARD_COLOR}[0] Disabled{RESET}")
                print(f"  {GREEN}[1] Temporary — only while this menu is open{RESET}")
                print(f"  {GREEN}[2] Permanent — background service, starts at boot{RESET}")
                action = ask("Select guard mode [0-2] (Enter/q = back): ")
                if action not in ("0", "1", "2"):
                    continue
                svc_present = any(os.path.exists(os.path.join(SYSTEMD_UNIT_DIR, u)) for u in (GUARD_UNIT, SLEEP_UNIT))
                if action == "1" and temporary.active() and not svc_present:
                    print(f"{GREEN}✓ Temporary guard is already active until this menu closes.{RESET}")
                    pause()
                    continue
                was_temp = temporary.active()
                if not temporary.stop():
                    pause()
                    continue
                if action == "2":
                    manage_client_guard("install")
                elif action == "0":
                    if svc_present:
                        manage_client_guard("uninstall")
                    elif was_temp:
                        print(f"{GREEN}✓ Temporary client sleep guard stopped.{RESET}")
                    else:
                        print(f"{DIM}Client sleep guard is already disabled.{RESET}")
                elif action == "1":
                    if not svc_present or manage_client_guard("uninstall"):
                        ok = temporary.start()
                        print(f"{GREEN}✓ Temporary guard active until this menu closes.{RESET}" if ok else
                              f"{RED}✗ Could not start temporary guard.{RESET}")
                pause()
            elif choice == "1":
                start_service()
                pause()
            elif choice == "2":
                stop_service()
                pause()
            elif choice == "3":
                bus = choose_item("device", local_busids, is_valid_busid, "a USB Bus ID to share (e.g. 1-1)")
                share_device(bus)
                pause()
            elif choice == "4":
                bus = choose_item("device", local_busids, is_valid_busid, "a USB Bus ID to unshare (e.g. 1-1)")
                unshare_device(bus)
                pause()
            elif choice == "5":
                run_doctor()
                pause()
            elif choice == "6":
                run_self_test()
                pause()
            elif choice == "7":
                if IS_MACOS:
                    log_file = "/var/log/usbanywhere-server.log"
                    if os.path.exists(log_file):
                        os.system(f"tail -n 30 {log_file}")
                    else:
                        print("Log file /var/log/usbanywhere-server.log does not exist yet.")
                elif IS_LINUX:
                    os.system("journalctl -u usbipd -n 30 --no-pager")
                pause()
            elif choice == "8":
                continue
            elif choice == "9":
                servers = scan_network_servers(numbered=True)
                srv_ip = choose_item("server", [ip for ip, _ in servers], is_valid_host,
                                     "a Remote Server IP (e.g. 192.168.1.50)")
                remote = list_remote_devices(srv_ip, numbered=True)
                rem_bus = choose_item("device", [extract_busid(r) for r in remote], is_valid_busid,
                                      "a Remote Bus ID to attach (e.g. 1-1)")
                connect_remote_device(srv_ip, rem_bus)
                pause()
            elif choice == "0":
                if list_client_ports() or load_client_state():
                    port_or_bus = ask("Enter Port number, Bus ID, or 'all' to detach (q to cancel): ")
                    if not port_or_bus:
                        raise PromptCancelled()
                    disconnect_remote_device(port_or_bus)
                pause()
        except PromptCancelled:
            continue
        except KeyboardInterrupt:
            print(f"\n{YELLOW}Cancelled.{RESET}")
            pause()

# ══════════════════════════════════════════════════════════════════════════════
# LINUX CLIENT MODE (vhci_hcd + On-Demand Dynamic BIND/UNBIND TCP 3241)
# ══════════════════════════════════════════════════════════════════════════════

def is_valid_host(host):
    """Validate hostname or IPv4 address strictly against command injection."""
    return bool(host and isinstance(host, str) and re.match(r"^[a-zA-Z0-9_][a-zA-Z0-9.\-_]*$", host.strip()))

def extract_busid(line):
    """Return the Bus ID at the start of a device listing line ('  1-1.2    : ...'), or None."""
    m = re.match(r"^\s*(\d+-[\d.]+)\s*:", line or "")
    return m.group(1) if m else None

def send_control_command(server_ip, cmd_line, port=CONTROL_PORT, timeout=2.5):
    """Send a single-line control command to remote TCP 3241 daemon and parse JSON response."""
    if not is_valid_host(server_ip):
        return None
    try:
        with socket.create_connection((server_ip.strip(), port), timeout=timeout) as s:
            s.sendall((cmd_line.strip() + "\n").encode("utf-8"))
            raw = s.recv(16384).decode("utf-8", errors="ignore").strip()
            if raw:
                return json.loads(raw.splitlines()[0])
    except Exception:
        pass
    return None

def scan_network_servers(port=CONTROL_PORT, timeout=1.2, numbered=False):
    """Broadcast UDP discovery probe on port 3241 to find USB/IP servers on LAN."""
    print(f"\n{CYAN}═══ 🔍 Scanning LAN for USB/IP Servers (UDP {port}) ═══{RESET}")
    found = []
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.settimeout(0.35)
        targets = {"255.255.255.255"}
        lan_ip = get_lan_ip()
        if lan_ip and "." in lan_ip and not lan_ip.startswith("127."):
            parts = lan_ip.split(".")
            if len(parts) == 4:
                targets.add(f"{parts[0]}.{parts[1]}.{parts[2]}.255")
        for bcast in targets:
            for probe in (b"USBANYWHERE_DISCOVERY_PROBE\n", b"USBANYWHERE_DISCOVERY_PROBE\n"):
                try:
                    sock.sendto(probe, (bcast, port))
                except Exception:
                    pass
        deadline = time.time() + timeout
        seen_ips = set()
        while time.time() < deadline:
            try:
                data, addr = sock.recvfrom(1024)
                ip = addr[0]
                if ip not in seen_ips:
                    seen_ips.add(ip)
                    msg = data.decode("utf-8", errors="ignore").strip()
                    host = msg.split(":", 1)[1] if ":" in msg else msg
                    found.append((ip, host))
            except socket.timeout:
                continue
            except Exception:
                break
        sock.close()
    except Exception as e:
        print(f"{YELLOW}Discovery warning: {e}{RESET}")

    if found:
        for idx, (ip, host) in enumerate(found, start=1):
            prefix = f"{BOLD}[{idx}]{RESET} " if numbered else ""
            print(f"  {prefix}{GREEN}●{RESET} {BOLD}{ip}{RESET} ({host})")
    else:
        print(f"  {DIM}No broadcast responders replied within {timeout:.1f}s (you can still connect by direct IP).{RESET}")
    return found

def list_remote_devices(server_ip, numbered=False):
    """List remote USB devices on server_ip using both TCP 3241 dynamic inventory and TCP 3240."""
    if not is_valid_host(server_ip):
        print(f"{RED}[Error] Invalid server IP or hostname: {server_ip}{RESET}")
        return []
    ip = server_ip.strip()
    print(f"\n{CYAN}═══ 🌐 Remote USB Devices on {ip} ═══{RESET}")
    results = []

    # 1. Query On-Demand Dynamic Control API (TCP 3241)
    dyn = send_control_command(ip, "LIST")
    if isinstance(dyn, dict) and isinstance(dyn.get("devices"), list):
        for item in dyn["devices"]:
            if isinstance(item, dict):
                bid = item.get("busid") or item.get("busId") or ""
                vid = item.get("vid") or item.get("vendorId") or ""
                pid = item.get("pid") or item.get("productId") or ""
                prod = item.get("product") or item.get("description") or "USB Device"
                line = f"  {bid:<8} : {prod} ({vid}:{pid})"
                results.append(line)
            elif isinstance(item, str) and item.strip():
                results.append("  " + item.strip())

    # 2. Fallback / supplement via standard usbip list -r <ip> (TCP 3240)
    if not results:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "list", "-r", ip], timeout=10)
            for line in out.splitlines():
                if re.search(r"^\s*\d+-[\d.]+\s*:", line):
                    results.append("  " + line.strip())

    if results:
        for idx, r in enumerate(results, start=1):
            print(f"  {BOLD}[{idx}]{RESET} {r.strip()}" if numbered else r)
    else:
        print(f"  {YELLOW}No remote USB devices found on {ip} (verify server IP and ports 3240/3241).{RESET}")
    return results

VHCI_PLATFORM_GLOB = "/sys/devices/platform/vhci_hcd.*"
VHCI_ST_USED = 6
VHCI_ST_ERROR = 7
CLIENT_RUN_DIR = "/run/usbanywhere"
CLIENT_LOCK_FILE = os.path.join(CLIENT_RUN_DIR, "client.lock")
CLIENT_STATE_FILE = os.path.join(CLIENT_RUN_DIR, "client-restore.json")
GUARD_UNIT = "usbanywhere-client-guard.service"
SLEEP_UNIT = "usbanywhere-client-sleep.service"
SYSTEMD_UNIT_DIR = "/etc/systemd/system"
GUARD_SLEEP_BUDGET = 4.0    # logind's default InhibitDelayMaxSec is 5s
GUARD_RESTORE_WINDOW = 180.0
GUARD_FORCE_REBIND_AFTER = 30.0

def run_bounded(cmd, timeout):
    """
    Like run_cmd_result(), but never blocks past the timeout: a process stuck in
    uninterruptible sleep (D state) cannot be reaped, so it is abandoned instead.
    """
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except Exception as e:
        return None, "", str(e)
    try:
        out, err = proc.communicate(timeout=max(0.1, timeout))
        return proc.returncode, (out or "").strip(), (err or "").strip()
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate(timeout=0.5)
        except Exception:
            pass
        return None, "", f"timed out after {timeout:.1f}s"

def read_vhci_status():
    """
    Read vhci_hcd port states from sysfs. Returns {port: {"status": int, "local_busid": str}},
    or None when no vhci_hcd controller exists (module not loaded).
    """
    import glob
    files = sorted(glob.glob(os.path.join(VHCI_PLATFORM_GLOB, "status*")))
    if not files:
        return None
    ports = {}
    for path in files:
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.read().splitlines()
        except Exception:
            continue
        for line in lines:
            parts = line.split()
            if not parts or parts[0] in ("hub", "port", "prt"):
                continue
            if parts[0] in ("hs", "ss"):
                parts = parts[1:]
            if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
                continue
            ports[int(parts[0])] = {
                "status": int(parts[1]),
                "local_busid": parts[-1] if len(parts) >= 6 and parts[-1] != "0-0" else "",
            }
    return ports

def _occupied_ports(status):
    return {p: s for p, s in (status or {}).items() if s["status"] in (VHCI_ST_USED, VHCI_ST_ERROR)}

def read_client_ports():
    """
    Return (entries, error) for imported USB/IP devices. A failing 'usbip port' is reported
    as an error and never as "no devices": occupied vhci ports found in sysfs are still
    returned (without remote ip/busid) so they can be detached.
    """
    status = read_vhci_status()
    if status is None:
        return [], None
    occupied = _occupied_ports(status)
    bin_path = shutil.which("usbip")
    error = None
    entries = []
    if not bin_path:
        error = "'usbip' binary not found"
    else:
        rc, out, err = run_bounded([bin_path, "port"], timeout=10)
        if rc != 0:
            error = f"'usbip port' failed: {err or out or f'exit code {rc}'}"
        else:
            entries = parse_client_ports(out)
    listed = {e["port"] for e in entries}
    missing = [p for p in sorted(occupied) if str(p) not in listed]
    if missing and not error:
        error = f"'usbip port' did not list occupied vhci port(s) {', '.join(map(str, missing))}"
    for p in missing:
        entries.append({"port": str(p), "ip": "", "busid": "", "desc": f"vhci port {p} (remote unknown)"})
    for e in entries:
        st = status.get(int(e["port"])) if e["port"].isdigit() else None
        e["state"] = st["status"] if st else None
    return entries, error

class client_lock:
    """
    Exclusive lock shared by manual connect/disconnect, the sleep guard and the sleep hook.
    flock() locks belong to the open file, so threads of one process also exclude each other.
    """
    def __init__(self, timeout=30.0):
        self.timeout = timeout
        self.fd = None
        self.acquired = False

    def __enter__(self):
        import fcntl
        try:
            os.makedirs(CLIENT_RUN_DIR, mode=0o755, exist_ok=True)
            self.fd = os.open(CLIENT_LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o644)
        except OSError:
            return False
        deadline = time.monotonic() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.acquired = True
                return True
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return False
                time.sleep(0.05)

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)  # also releases the lock
            self.fd = None
        return False

def load_client_state():
    """Devices detached for suspend that still have to be restored: [{'ip':..., 'busid':...}]."""
    try:
        with open(CLIENT_STATE_FILE, "r", encoding="utf-8") as f:
            devs = json.load(f).get("devices", [])
        return [{"ip": d["ip"], "busid": d["busid"]} for d in devs
                if is_valid_host(d.get("ip")) and is_valid_busid(d.get("busid"))]
    except Exception:
        return []

def save_client_state(devices):
    uniq = []
    for d in devices:
        key = {"ip": d["ip"], "busid": d["busid"]}
        if key not in uniq:
            uniq.append(key)
    try:
        if not uniq:
            if os.path.exists(CLIENT_STATE_FILE):
                os.remove(CLIENT_STATE_FILE)
            return True
        os.makedirs(CLIENT_RUN_DIR, mode=0o755, exist_ok=True)
        tmp = CLIENT_STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"devices": uniq, "updated": time.time()}, f, indent=2)
        os.replace(tmp, CLIENT_STATE_FILE)
        return True
    except Exception:
        return False

def _same_remote(entry, ip, busid):
    return entry.get("ip", "").lower() == ip.lower() and entry.get("busid", "") == busid

def detach_client_ports(entries, deadline):
    """
    Detach vhci ports and verify in sysfs that they were released.
    Returns (released_entries, failed [(entry, reason)]). Never waits past `deadline`.
    """
    bin_path = shutil.which("usbip")
    for e in entries:
        remaining = deadline - time.monotonic()
        if remaining <= 0.2:
            break
        rc, out, err = (None, "", "'usbip' binary not found")
        if bin_path:
            rc, out, err = run_bounded([bin_path, "detach", "-p", e["port"]], timeout=min(2.0, remaining))
        if rc != 0 and e["port"].isdigit():
            # Fall back to the kernel interface used by 'usbip detach'
            remaining = deadline - time.monotonic()
            if remaining > 0.2:
                run_bounded(["sh", "-c", f"echo {int(e['port'])} > /sys/devices/platform/vhci_hcd.0/detach"],
                            timeout=min(1.5, remaining))
        e["_detach_msg"] = err or out
    released, failed = [], []
    while True:
        status = read_vhci_status() or {}
        busy = _occupied_ports(status)
        pending = [e for e in entries if e["port"].isdigit() and int(e["port"]) in busy]
        if not pending or time.monotonic() >= deadline:
            break
        time.sleep(0.1)
    for e in entries:
        if e in pending or not e["port"].isdigit():
            failed.append((e, e.get("_detach_msg") or "port still in use"))
        else:
            released.append(e)
    return released, failed

def attach_remote_device(ip, busid, attach_timeout=10.0, verify_timeout=5.0):
    """
    Bind (TCP 3241, if supported) and attach a remote device, then verify that a vhci port
    shows ip/busid. Caller must hold client_lock. Returns (ok, message).
    """
    entries, err = read_client_ports()
    if err:
        return False, f"cannot check attached ports: {err}"
    for e in entries:
        if _same_remote(e, ip, busid):
            if e.get("state") == VHCI_ST_ERROR:
                detach_client_ports([e], time.monotonic() + 3)
                break
            return True, f"already attached on port {e['port']}"

    bin_path = shutil.which("usbip")
    if not bin_path:
        return False, "'usbip' client binary not found. Install linux-tools-generic or usbip."
    run_bounded(["modprobe", "usbip_core"], timeout=10)
    rc, _, merr = run_bounded(["modprobe", "vhci_hcd"], timeout=10)
    if rc != 0:
        return False, f"could not load vhci_hcd kernel module: {merr or f'exit code {rc}'}"

    notes = []
    bind_resp = send_control_command(ip, f"BIND {busid}", timeout=2.0)
    if isinstance(bind_resp, dict):
        st = (bind_resp.get("status") or "").upper()
        if st == "DENIED":
            return False, f"remote server denied export of {busid}: {bind_resp.get('message')}"
        if st == "OK":
            notes.append(f"on-demand BIND accepted by {ip}:{CONTROL_PORT}")
            time.sleep(0.25)
        elif bind_resp.get("message"):
            notes.append(f"remote BIND reported: {bind_resp.get('message')}")

    # usbip reports errors on stderr, so check the exit code and both streams
    rc, out, aerr = run_bounded([bin_path, "attach", "-r", ip, "-b", busid], timeout=attach_timeout)
    combined = f"{out}\n{aerr}".strip()
    if rc != 0 or "error" in combined.lower() or "failed" in combined.lower():
        return False, f"attach failed: {combined or f'exit code {rc}'}"

    deadline = time.monotonic() + verify_timeout
    while True:
        entries, err = read_client_ports()
        match = [e for e in entries if _same_remote(e, ip, busid) and e.get("state") == VHCI_ST_USED]
        if match:
            notes.append(f"verified on vhci port {match[0]['port']}")
            return True, "; ".join(notes)
        if time.monotonic() >= deadline:
            detail = f" ({err})" if err else ""
            return False, f"'usbip attach' returned success but no vhci port shows {ip}/{busid}{detail}"
        time.sleep(0.2)

def connect_remote_device(server_ip, busid):
    """Attach a remote USB/IP device into local Linux vhci_hcd client driver (with on-demand TCP 3241 BIND)."""
    if not IS_LINUX:
        print(f"{RED}[Error] Native vhci_hcd client attach is only supported on Linux.{RESET}")
        return False
    if not is_valid_host(server_ip) or not is_valid_busid(busid):
        print(f"{RED}[Error] Invalid Server IP ({server_ip}) or Bus ID ({busid}).{RESET}")
        return False
    ip = server_ip.strip()
    bid = busid.strip()

    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required for vhci_hcd attach. Re-running with sudo...{RESET}")
        return rerun_with_sudo("connect", ip, bid)

    with client_lock(timeout=30) as locked:
        if not locked:
            print(f"{RED}✗ Another USB/IP client operation (sleep guard or attach/detach) is still running. Try again.{RESET}")
            return False
        ok, msg = attach_remote_device(ip, bid)
    if ok:
        print(f"{GREEN}✓ Attached {bid} from {ip} into local Linux vhci_hcd ({msg}).{RESET}")
    else:
        print(f"{RED}✗ Failed to attach {bid} from {ip}: {msg}{RESET}")
    return ok

def parse_client_ports(port_output):
    """Parse 'usbip port' output into list of dicts: [{'port': '00', 'ip': '...', 'busid': '...', 'desc': '...'}]."""
    entries = []
    cur = None
    for line in (port_output or "").splitlines():
        m_port = re.search(r"Port\s+(\d+)\s*:", line, re.IGNORECASE)
        if m_port:
            if cur:
                entries.append(cur)
            cur = {"port": str(int(m_port.group(1))), "ip": "", "busid": "", "desc": line.strip()}
            continue
        if cur:
            m_url = re.search(r"usbip://([a-zA-Z0-9.\-_]+):\d+/(\d+-[\d.]+)", line)
            if m_url:
                cur["ip"] = m_url.group(1)
                cur["busid"] = m_url.group(2)
            else:
                m_bus = re.search(r"busid\s+(\d+-[\d.]+)", line, re.IGNORECASE)
                if m_bus and not cur["busid"]:
                    cur["busid"] = m_bus.group(1)
            if "->" not in line and not m_url and line.strip():
                cur["desc"] = line.strip()
    if cur:
        entries.append(cur)
    return entries

def list_client_ports():
    """Display currently attached remote USB devices on this Linux client."""
    entries, err = read_client_ports()
    if err:
        print(f"{RED}[Error] Could not read attached ports reliably: {err}{RESET}")
    print(f"\n{CYAN}═══ 🔌 Attached Remote USB Ports ({len(entries)}) ═══{RESET}")
    if not entries:
        print(f"  {DIM}{'Unknown.' if err else 'No remote USB devices currently attached.'}{RESET}")
    else:
        for e in entries:
            remote_str = f"{e['ip']}/{e['busid']}" if e["ip"] or e["busid"] else "remote"
            print(f"  • Port {BOLD}{e['port']}{RESET}: {remote_str} — {e['desc']}")
    pending = load_client_state()
    if pending:
        items = ", ".join(f"{d['ip']}/{d['busid']}" for d in pending)
        print(f"  {YELLOW}Waiting to be restored after resume: {items}{RESET}")
    return entries

def disconnect_remote_device(target="all"):
    """Detach a remote USB/IP port on Linux client and send on-demand UNBIND to remote TCP 3241."""
    if not IS_LINUX:
        print(f"{RED}[Error] Native vhci_hcd client detach is only supported on Linux.{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required for vhci_hcd detach. Re-running with sudo...{RESET}")
        return rerun_with_sudo("disconnect", (target or "all").strip())

    with client_lock(timeout=30) as locked:
        if not locked:
            print(f"{RED}✗ Another USB/IP client operation (sleep guard or attach/detach) is still running. Try again.{RESET}")
            return False
        return _disconnect_locked(target)

def _disconnect_locked(target):
    tgt = (target or "all").strip().lower()
    tgt_port = str(int(tgt)) if tgt.isdigit() else tgt

    # A manual detach also cancels a pending restore of the same device
    pending = load_client_state()
    keep = [d for d in pending if not (tgt == "all" or d["busid"].lower() == tgt)]
    dropped = [d for d in pending if d not in keep]

    entries, err = read_client_ports()
    if err:
        print(f"{YELLOW}[!] Could not read attached ports reliably: {err}{RESET}")
    matched = [e for e in entries if tgt == "all" or e["port"] == tgt_port or e["busid"].lower() == tgt]
    if not matched and tgt.isdigit():
        status = read_vhci_status() or {}
        if int(tgt) in _occupied_ports(status):
            matched = [{"port": tgt_port, "ip": "", "busid": "", "desc": ""}]
    for e in matched:
        keep = [d for d in keep if not _same_remote(e, d["ip"], d["busid"])]
    if len(keep) != len(pending):
        save_client_state(keep)
        for d in pending:
            if d not in keep:
                print(f"{GREEN}✓ Cancelled pending restore of {d['ip']}/{d['busid']}{RESET}")

    if not matched:
        if err and not entries:
            print(f"{RED}✗ Cannot tell which ports are attached, nothing was detached.{RESET}")
            return False
        if dropped:
            return True
        if not entries:
            print(f"{YELLOW}No attached USB/IP client ports found.{RESET}")
            return True
        print(f"{YELLOW}No attached port or Bus ID matches '{target}'.{RESET}")
        return False

    released, failed = detach_client_ports(matched, time.monotonic() + 10)
    for e, reason in failed:
        print(f"{RED}✗ Failed to detach Port {e['port']}: {reason or 'port still in use'}{RESET}")
    for e in released:
        print(f"{GREEN}✓ Detached local vhci_hcd Port {e['port']} (verified released){RESET}")
        if e["ip"] and e["busid"]:
            unbind_resp = send_control_command(e["ip"], f"UNBIND {e['busid']}")
            if isinstance(unbind_resp, dict) and (unbind_resp.get("status") or "").upper() == "OK":
                print(f"{GREEN}✓ Released {e['busid']} back to remote host {e['ip']}{RESET}")
    return not failed

# ══════════════════════════════════════════════════════════════════════════════
# LINUX CLIENT SLEEP GUARD (logind PrepareForSleep + delay inhibitor)
# ══════════════════════════════════════════════════════════════════════════════

def glog(level, msg):
    """Log a line for the journal (sd-daemon priority prefix) or the terminal."""
    prio = {"error": 3, "warning": 4, "info": 6}.get(level, 6)
    if sys.stdout.isatty():
        color = {"error": RED, "warning": YELLOW}.get(level, "")
        print(f"{color}{msg}{RESET if color else ''}", flush=True)
    else:
        print(f"<{prio}>{msg}", flush=True)

def tcp_reachable(host, port=PORT, timeout=1.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False

def client_suspend_detach(deadline, log=glog):
    """
    Detach every imported device before sleep, record it for restore and verify the release.
    Network-independent: the remote UNBIND is only attempted with the time left.
    Caller must hold client_lock (or have failed to get it in time). Returns True if all released.
    """
    entries, err = read_client_ports()
    if err:
        log("warning", f"Port listing incomplete: {err}")
    if not entries:
        if not err:
            log("info", "No imported USB/IP devices to detach.")
        return not err
    restorable = [{"ip": e["ip"], "busid": e["busid"]} for e in entries if e["ip"] and e["busid"]]
    if not save_client_state(load_client_state() + restorable):
        log("error", f"Could not write {CLIENT_STATE_FILE}: devices will not be restored after resume.")
    for e in entries:
        if not (e["ip"] and e["busid"]):
            log("warning", f"Port {e['port']}: remote ip/busid unknown, it will be detached but not restored.")

    released, failed = detach_client_ports(entries, deadline)
    for e in released:
        log("info", f"Detached port {e['port']} ({e['ip']}/{e['busid']}), released in sysfs.")
    for e, reason in failed:
        log("error", f"Port {e['port']} ({e['ip']}/{e['busid']}) NOT released before sleep: {reason}")
    remaining = deadline - time.monotonic()
    if released and remaining > 0.3:
        rc, _, serr = run_bounded(["udevadm", "settle", f"--timeout={max(1, int(min(remaining - 0.2, 2)))}"],
                                  timeout=min(remaining - 0.1, 2.5))
        if rc != 0:
            log("warning", f"udevadm settle: {serr or f'exit code {rc}'}")
    for e in released:
        remaining = deadline - time.monotonic()
        if not (e["ip"] and e["busid"]) or remaining < 0.3:
            continue
        resp = send_control_command(e["ip"], f"UNBIND {e['busid']}", timeout=min(1.0, remaining - 0.1))
        if isinstance(resp, dict) and (resp.get("status") or "").upper() == "OK":
            log("info", f"Remote {e['ip']} released {e['busid']}.")
    return not failed

class ClientSleepGuard:
    """Detach imported USB/IP devices on PrepareForSleep(true), restore them on PrepareForSleep(false)."""

    def __init__(self, log=glog):
        self.log = log
        self.inhibitor = None
        self.monitor = None
        self.restore_thread = None
        self.restore_cancel = threading.Event()
        self.stopping = threading.Event()
        self.logind_owner = None

    # ── logind delay inhibitor ──
    def take_inhibitor(self):
        if self.inhibitor and self.inhibitor.poll() is None:
            return True
        try:
            self.inhibitor = subprocess.Popen(
                ["systemd-inhibit", "--what=sleep", "--mode=delay", "--who=USBAnywhere",
                 "--why=Detach imported USB/IP devices before sleep", "sleep", "infinity"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                start_new_session=True)
        except OSError as e:
            self.log("error", f"Could not start systemd-inhibit: {e}")
            return False
        for _ in range(30):
            if self.inhibitor.poll() is not None:
                err = (self.inhibitor.stderr.read() or b"").decode(errors="ignore").strip()
                self.log("error", f"systemd-inhibit exited: {err or self.inhibitor.returncode}")
                return False
            if self.inhibitor.pid in self.inhibitor_pids():
                return True
            time.sleep(0.1)
        self.log("warning", "Delay inhibitor not visible in logind yet.")
        return True

    def release_inhibitor(self):
        proc, self.inhibitor = self.inhibitor, None
        if proc and proc.poll() is None:
            try:
                os.killpg(proc.pid, 15)
            except OSError:
                proc.terminate()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()

    @staticmethod
    def inhibitor_pids():
        rc, out, _ = run_bounded(["busctl", "--system", "--json=short", "call", "org.freedesktop.login1",
                                  "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                                  "ListInhibitors"], timeout=3)
        try:
            return {i[5] for i in json.loads(out)["data"][0] if i[1] == "USBAnywhere"} if rc == 0 else set()
        except Exception:
            return set()

    def refresh_logind_owner(self):
        rc, out, _ = run_bounded(["busctl", "--system", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                  "org.freedesktop.DBus", "GetNameOwner", "s", "org.freedesktop.login1"], timeout=3)
        m = re.search(r'"(:[\d.]+)"', out) if rc == 0 else None
        self.logind_owner = m.group(1) if m else None
        return self.logind_owner

    def parse_signal(self, line):
        """Return True/False for a genuine logind PrepareForSleep signal line, else None."""
        try:
            msg = json.loads(line)
        except ValueError:
            return None
        if (msg.get("type") != "signal" or msg.get("member") != "PrepareForSleep"
                or msg.get("interface") != "org.freedesktop.login1.Manager"
                or msg.get("path") != "/org/freedesktop/login1"):
            return None
        data = (msg.get("payload") or {}).get("data") or []
        if not data or not isinstance(data[0], bool):
            return None
        sender = msg.get("sender")
        if sender != self.logind_owner and sender != self.refresh_logind_owner():
            self.log("warning", f"Ignoring PrepareForSleep from {sender} (logind is {self.logind_owner}).")
            return None
        return data[0]

    # ── sleep / resume handlers ──
    def on_prepare_sleep(self):
        t0 = time.monotonic()
        deadline = t0 + GUARD_SLEEP_BUDGET
        self.log("info", "PrepareForSleep(true): detaching imported USB/IP devices.")
        self.cancel_restore(wait=1.0)
        with client_lock(timeout=max(0.2, deadline - time.monotonic() - 2.5)) as locked:
            if not locked:
                self.log("warning", "Client lock busy (manual attach/detach?): detaching anyway.")
            ok = client_suspend_detach(deadline, self.log)
        self.release_inhibitor()
        took = time.monotonic() - t0
        if ok:
            self.log("info", f"Ready for sleep after {took:.2f}s, inhibitor released.")
        else:
            self.log("error", f"Some ports were not released ({took:.2f}s); inhibitor released anyway.")

    def on_resume(self):
        self.log("info", "PrepareForSleep(false): resumed or sleep aborted.")
        self.take_inhibitor()
        self.start_restore()

    def cancel_restore(self, wait=0.0):
        self.restore_cancel.set()
        t = self.restore_thread
        if t and t.is_alive() and wait:
            t.join(wait)

    def start_restore(self):
        if not load_client_state():
            return
        self.cancel_restore(wait=2.0)
        self.restore_cancel = threading.Event()
        self.restore_thread = threading.Thread(target=self.restore_loop, args=(self.restore_cancel,), daemon=True)
        self.restore_thread.start()

    def force_rebind(self, ip, busid):
        un = send_control_command(ip, f"UNBIND {busid}", timeout=2.0)
        time.sleep(0.5)
        bi = send_control_command(ip, f"BIND {busid}", timeout=2.0)
        self.log("warning", f"Forced UNBIND+BIND of {busid} on {ip} to drop a stale session "
                            f"(unbind={un and un.get('status')}, bind={bi and bi.get('status')}).")

    def restore_loop(self, cancel, window=GUARD_RESTORE_WINDOW, max_delay=10.0):
        start = time.monotonic()
        first_fail = {}
        forced = set()
        delay = min(1.0, max_delay)
        while not cancel.is_set():
            pending = load_client_state()
            if not pending:
                self.log("info", "All USB/IP devices restored.")
                return
            for dev in pending:
                if cancel.is_set():
                    return
                ip, busid = dev["ip"], dev["busid"]
                key = (ip, busid)
                if not tcp_reachable(ip, PORT, timeout=1.5):
                    continue
                with client_lock(timeout=5) as locked:
                    if not locked or cancel.is_set():
                        continue
                    if dev not in load_client_state():
                        continue  # cancelled by a manual detach
                    ok, msg = attach_remote_device(ip, busid, attach_timeout=8.0)
                    if ok:
                        save_client_state([d for d in load_client_state() if d != dev])
                if ok:
                    self.log("info", f"Restored {ip}/{busid}: {msg}")
                    continue
                self.log("warning", f"Restore of {ip}/{busid} failed: {msg}")
                first_fail.setdefault(key, time.monotonic())
                if key not in forced and time.monotonic() - first_fail[key] >= GUARD_FORCE_REBIND_AFTER:
                    forced.add(key)
                    self.force_rebind(ip, busid)
            if time.monotonic() - start >= window:
                left = load_client_state()
                if left:
                    unreachable = [f"{d['ip']}/{d['busid']}" for d in left if (d["ip"], d["busid"]) not in first_fail]
                    self.log("error", f"Gave up restoring after {window:.0f}s: "
                                      f"{', '.join(d['ip'] + '/' + d['busid'] for d in left)}"
                                      + (f" (server never reachable: {', '.join(unreachable)})" if unreachable else "")
                                      + ". Reconnect manually with 'usbanywhere-ctl connect'.")
                    save_client_state([])
                return
            cancel.wait(delay)
            delay = min(delay * 1.5, max_delay)

    # ── main loop ──
    def handle_line(self, line):
        value = self.parse_signal(line)
        if value is True:
            self.on_prepare_sleep()
        elif value is False:
            self.on_resume()

    def stop(self, *_):
        self.stopping.set()
        self.cancel_restore()
        mon = self.monitor
        if mon and mon.poll() is None:
            mon.terminate()

    def run(self):
        import fcntl
        os.makedirs(CLIENT_RUN_DIR, mode=0o755, exist_ok=True)
        with open(os.path.join(CLIENT_RUN_DIR, "guard.lock"), "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                self.log("error", "Another client guard is running; close its menu first.")
                return False
            return self._run()

    def _run(self):
        import signal
        signal.signal(signal.SIGTERM, self.stop)
        signal.signal(signal.SIGINT, self.stop)
        if not shutil.which("busctl") or not shutil.which("systemd-inhibit"):
            self.log("error", "busctl and systemd-inhibit (systemd) are required.")
            return False
        self.refresh_logind_owner()
        self.log("info", f"USBAnywhere client sleep guard v{VERSION} started (logind {self.logind_owner}).")
        try:
            while not self.stopping.is_set():
                self.monitor = subprocess.Popen(
                    ["busctl", "--system", "--json=short", "monitor", "--match",
                     "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                # Subscribe first, then inhibit, so no PrepareForSleep can slip in between.
                time.sleep(0.3)
                if self.stopping.is_set():
                    break
                self.take_inhibitor()
                if load_client_state():
                    self.log("info", "Pending devices from a previous sleep: restoring.")
                    self.start_restore()
                for line in self.monitor.stdout:
                    if self.stopping.is_set():
                        break
                    try:
                        self.handle_line(line)
                    except Exception as e:
                        self.log("error", f"Error handling sleep signal: {e}")
                        self.take_inhibitor()
                if not self.stopping.is_set():
                    self.log("warning", f"busctl monitor exited ({self.monitor.wait()}), restarting.")
                    self.stopping.wait(2)
        finally:
            self.release_inhibitor()
            if self.monitor and self.monitor.poll() is None:
                self.monitor.terminate()
            self.log("info", "Client sleep guard stopped.")
        return True

def run_client_sleep_hook(phase="pre"):
    """Fallback for sleep.target: detach anything still attached (e.g. guard not running)."""
    if phase != "pre":
        glog("error", f"Unknown sleep hook phase '{phase}' (only 'pre' is supported).")
        return False
    deadline = time.monotonic() + 8.0
    with client_lock(timeout=3) as locked:
        if not locked:
            glog("warning", "Client lock busy: detaching anyway.")
        return client_suspend_detach(deadline)

def _guard_units():
    exe = f"{sys.executable} {os.path.realpath(__file__)}"
    guard = f"""[Unit]
Description=USBAnywhere client sleep guard (detach imported USB/IP devices before sleep, restore on resume)
After=dbus.service systemd-logind.service

[Service]
Type=simple
ExecStart={exe} client-guard run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
"""
    hook = f"""[Unit]
Description=USBAnywhere: detach imported USB/IP devices before sleep (fallback)
Before=sleep.target

[Service]
Type=oneshot
ExecStart={exe} client-sleep-hook pre
TimeoutStartSec=15

[Install]
WantedBy=sleep.target
"""
    return {GUARD_UNIT: guard, SLEEP_UNIT: hook}

def manage_client_guard(action="status"):
    """client-guard run|install|uninstall|status"""
    action = (action or "status").lower()
    if action == "status":
        for unit in (GUARD_UNIT, SLEEP_UNIT):
            enabled = run_cmd(["systemctl", "is-enabled", unit]) or "not installed"
            active = run_cmd(["systemctl", "is-active", unit]) or "unknown"
            print(f"{unit:<36} enabled: {enabled:<14} active: {active}")
        pids = ClientSleepGuard.inhibitor_pids() if shutil.which("busctl") else set()
        print(f"Sleep delay inhibitor:               {GREEN + 'held' + RESET if pids else YELLOW + 'not held' + RESET}")
        pending = load_client_state()
        print(f"Pending restore:                     {', '.join(d['ip'] + '/' + d['busid'] for d in pending) or 'none'}")
        return True
    if not IS_LINUX:
        print(f"{RED}[Error] The client sleep guard is only supported on Linux with systemd.{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("client-guard", action)
    if action == "run":
        return ClientSleepGuard().run()
    if action == "session":
        guard = ClientSleepGuard()
        def watch_dashboard():
            try:
                fd = sys.stdin.fileno()
                while os.read(fd, 1):
                    pass
            except OSError:
                pass
            finally:
                guard.stop()
        threading.Thread(target=watch_dashboard, daemon=True).start()
        return guard.run()
    if action == "install":
        try:
            for name, text in _guard_units().items():
                with open(os.path.join(SYSTEMD_UNIT_DIR, name), "w", encoding="utf-8") as f:
                    f.write(text)
        except OSError as e:
            print(f"{RED}✗ Could not write systemd units: {e}{RESET}")
            return False
        before = ClientSleepGuard.inhibitor_pids()
        steps = [["systemctl", "daemon-reload"], ["systemctl", "enable", SLEEP_UNIT],
                 ["systemctl", "enable", GUARD_UNIT], ["systemctl", "restart", GUARD_UNIT]]
        for cmd in steps:
            rc, out, err = run_cmd_result(cmd)
            if rc != 0:
                print(f"{RED}✗ {' '.join(cmd)}: {err or out or f'exit code {rc}'}{RESET}")
                return False
        for _ in range(30):
            if ClientSleepGuard.inhibitor_pids() - before:
                print(f"{GREEN}✓ Client sleep guard installed and running (delay inhibitor held).{RESET}")
                return True
            time.sleep(0.2)
        print(f"{RED}✗ Guard started but its inhibitor is not visible: check 'journalctl -u {GUARD_UNIT}'.{RESET}")
        return False
    if action == "uninstall":
        for name in (GUARD_UNIT, SLEEP_UNIT):
            if not os.path.exists(os.path.join(SYSTEMD_UNIT_DIR, name)):
                continue
            rc, out, err = run_cmd_result(["systemctl", "disable", "--now", name])
            if rc != 0:
                print(f"{RED}Could not disable {name}: {err or out}{RESET}")
                return False
        for name in (GUARD_UNIT, SLEEP_UNIT):
            try:
                os.remove(os.path.join(SYSTEMD_UNIT_DIR, name))
            except FileNotFoundError:
                pass
        rc, out, err = run_cmd_result(["systemctl", "daemon-reload"])
        if rc != 0:
            print(f"{RED}Could not reload systemd: {err or out}{RESET}")
            return False
        print(f"{GREEN}✓ Client sleep guard removed.{RESET}")
        return True
    print("Usage: usbanywhere-ctl client-guard [status|install|uninstall|run]")
    return False

# ══════════════════════════════════════════════════════════════════════════════
# MAIN DISPATCHER
# ══════════════════════════════════════════════════════════════════════════════

def apply_dualsense_fix():
    """Install udev quirk for Sony DualSense (054c:0ce6 / 054c:0df2) and check Raspberry Pi dwc2 overlay."""
    if not IS_LINUX:
        print(f"{YELLOW}DualSense udev/dwc2 fix is only applicable on Linux / Raspberry Pi hosts.{RESET}")
        return False
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return rerun_with_sudo("fix-dualsense")

    rule_path = "/etc/udev/rules.d/99-usbanywhere-dualsense-fix.rules"
    rule_content = (
        "# USBAnywhere — Prevent hid-playstation race, USB autosuspend, and ARM64 usbip_host isoc audio Oops on DualSense / DualSense Edge\n"
        'ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0ce6", ATTR{power/control}="on"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0df2", ATTR{power/control}="on"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", ATTR{bInterfaceClass}=="01", ATTR{authorized}="0"\n'
        'ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", ATTR{bInterfaceClass}=="01", ATTR{authorized}="0"\n'
        'ACTION=="add", SUBSYSTEM=="hid", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", RUN+="/bin/sh -c \'echo $kernel > /sys/bus/hid/drivers/playstation/unbind 2>/dev/null || true\'"\n'
        'ACTION=="add", SUBSYSTEM=="hid", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", RUN+="/bin/sh -c \'echo $kernel > /sys/bus/hid/drivers/playstation/unbind 2>/dev/null || true\'"\n'
    )
    try:
        os.makedirs("/etc/udev/rules.d", exist_ok=True)
        with open(rule_path, "w", encoding="utf-8") as f:
            f.write(rule_content)
        run_cmd(["udevadm", "control", "--reload-rules"])
        run_cmd(["udevadm", "trigger"])
        print(f"{GREEN}✓ Installed DualSense udev protection rule at {rule_path}{RESET}")
    except Exception as e:
        print(f"{RED}✗ Failed to write udev rule: {e}{RESET}")
        return False

    # Check Raspberry Pi config.txt for dwc2 host mode if dwc_otg is currently bound
    for cfg in ("/boot/firmware/config.txt", "/boot/config.txt"):
        if os.path.isfile(cfg):
            try:
                with open(cfg, "r", encoding="utf-8") as f:
                    txt = f.read()
                if "dtoverlay=dwc2" not in txt:
                    print(f"{YELLOW}[!] Raspberry Pi detected ({cfg}) without 'dtoverlay=dwc2,dr_mode=host'.{RESET}")
                    print(f"    To prevent dwc_otg kernel Oops behind USB 2.0 Hub HATs, add under [all]:")
                    print(f"    {CYAN}dtoverlay=dwc2,dr_mode=host{RESET}")
            except Exception:
                pass
            break
    return True

def main():
    parser = argparse.ArgumentParser(
        description=f"USBAnywhere Control Suite v{VERSION} — macOS & Linux",
        epilog="Run without arguments to launch interactive Control Dashboard."
    )
    parser.add_argument("command", nargs="?", default="dashboard",
                        choices=["dashboard", "status", "start", "stop", "restart",
                                 "list", "share", "unshare", "policy", "auto-unbind",
                                 "dynamic-daemon", "fix-dualsense", "doctor", "test", "logs",
                                 "scan", "remote", "connect", "attach", "disconnect", "detach", "ports", "mode",
                                 "client-guard", "client-sleep-hook"],
                        help="Action to perform (default: interactive dashboard)")
    parser.add_argument("busid", nargs="?", default=None, help="Target USB bus ID or action parameter")
    parser.add_argument("extra", nargs="?", default=None, help="Additional argument for policy management")
    parser.add_argument("--json", action="store_true", help="Output status in JSON format")

    args = parser.parse_args()

    if args.command == "dashboard":
        role = load_role()
        if not role:
            role = ask_role()
            save_role(role)
        offer_sudo_relaunch(role)
        render_dashboard(role)
    elif args.command == "mode":
        if args.busid:
            if args.busid not in ROLES:
                print(f"{RED}Error: mode must be one of: {', '.join(ROLES)}{RESET}")
                sys.exit(1)
            sys.exit(0 if save_role(args.busid) else 1)
        print(load_role() or "not set")
    elif args.command == "status":
        st = get_service_status()
        st["lan_ip"] = get_lan_ip()
        st["devices"] = list_devices()
        if args.json:
            print(json.dumps(st, indent=2))
        else:
            status_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
            print(f"USBAnywhere Server: {status_str} (via {st['service_manager']})")
            print(f"Port 3240:         {GREEN}OPEN{RESET}" if st["port_active"] else f"Port 3240: {RED}CLOSED{RESET}")
            print(f"LAN IP:            {st['lan_ip']}")
            print(f"Devices detected:  {len(st['devices'])}")
    elif args.command == "start":
        sys.exit(0 if start_service() else 1)
    elif args.command == "stop":
        sys.exit(0 if stop_service() else 1)
    elif args.command == "restart":
        if not is_root():
            print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
            sys.exit(0 if rerun_with_sudo("restart") else 1)
        stop_service()
        time.sleep(1)
        sys.exit(0 if start_service() else 1)
    elif args.command == "list":
        devs = list_devices()
        print(f"Discovered USB Peripherals ({len(devs)}):")
        for d in devs:
            print(f"  {d}")
    elif args.command == "share":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl share <busid>{RESET}")
            sys.exit(1)
        sys.exit(0 if share_device(args.busid) else 1)
    elif args.command == "unshare":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl unshare <busid>{RESET}")
            sys.exit(1)
        sys.exit(0 if unshare_device(args.busid) else 1)
    elif args.command == "policy":
        pol = load_policy()
        action = (args.busid or "").lower()
        target = args.extra or ""
        if not action or action == "show":
            print(f"{CYAN}═══ 🛡️ USBAnywhere Host Export Policy ═══{RESET}")
            print(f"Policy file:        {POLICY_FILE}")
            print(f"Allow all devices:  {GREEN}YES{RESET}" if pol.get("allow_all") else f"Allow all: {YELLOW}NO{RESET}")
            print(f"Protect local HID:  {GREEN}ACTIVE{RESET}" if pol.get("protect_local_hid") else f"Protect local HID: {DIM}OFF{RESET}")
            print(f"Allowlist ({len(pol.get('allowlist', []))}):   {pol.get('allowlist', [])}")
            print(f"Denylist ({len(pol.get('denylist', []))}):    {pol.get('denylist', [])}")
        elif action == "deny" and target:
            if target not in pol.get("denylist", []):
                pol.setdefault("denylist", []).append(target)
                save_policy(pol)
                print(f"{GREEN}✓ Added '{target}' to denylist.{RESET}")
        elif action == "allow" and target:
            if target not in pol.get("allowlist", []):
                pol.setdefault("allowlist", []).append(target)
                save_policy(pol)
                print(f"{GREEN}✓ Added '{target}' to allowlist.{RESET}")
        elif action == "remove" and target:
            changed = False
            if target in pol.get("denylist", []):
                pol["denylist"].remove(target)
                changed = True
            if target in pol.get("allowlist", []):
                pol["allowlist"].remove(target)
                changed = True
            if changed:
                save_policy(pol)
                print(f"{GREEN}✓ Removed '{target}' from policy lists.{RESET}")
            else:
                print(f"{YELLOW}Target '{target}' not found in policy lists.{RESET}")
        elif action == "protect-hid":
            flag = target.lower() in ["true", "1", "on", "yes"]
            pol["protect_local_hid"] = flag
            save_policy(pol)
            state = f"{GREEN}ENABLED{RESET}" if flag else f"{YELLOW}DISABLED{RESET}"
            print(f"✓ Local HID Protection is now {state}.")
        elif action == "allow-ip" and target:
            ips = pol.setdefault("allowed_ips", [])
            if target not in ips:
                ips.append(target)
                save_policy(pol)
            print(f"{GREEN}✓ Added '{target}' to allowed_ips.{RESET}")
        elif action == "deny-ip" and target:
            ips = pol.get("allowed_ips", [])
            if target in ips:
                ips.remove(target)
                save_policy(pol)
                print(f"{GREEN}✓ Removed '{target}' from allowed_ips.{RESET}")
        elif action == "set-token" and target:
            pol["control_token"] = target.strip()
            save_policy(pol)
            print(f"{GREEN}✓ Control API token configured.{RESET}")
        elif action == "clear-token":
            pol["control_token"] = ""
            save_policy(pol)
            print(f"{GREEN}✓ Control API token cleared (open LAN mode).{RESET}")
        else:
            print(f"Usage:")
            print(f"  usbanywhere-ctl policy [show]")
            print(f"  usbanywhere-ctl policy deny <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy allow <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy remove <busid|vid:pid>")
            print(f"  usbanywhere-ctl policy protect-hid <on|off>")
    elif args.command == "auto-unbind":
        run_auto_unbind_daemon()
    elif args.command == "dynamic-daemon":
        run_dynamic_daemon()
    elif args.command == "fix-dualsense":
        ok = apply_dualsense_fix()
        sys.exit(0 if ok else 1)
    elif args.command == "doctor":
        run_doctor()
    elif args.command == "test":
        ok = run_self_test()
        sys.exit(0 if ok else 1)
    elif args.command == "logs":
        if IS_MACOS:
            os.system("tail -f /var/log/usbanywhere-server.log")
        elif IS_LINUX:
            os.system("journalctl -u usbipd -f")
    elif args.command == "scan":
        scan_network_servers()
    elif args.command == "remote":
        if not args.busid:
            print(f"{RED}Error: Missing server IP. Usage: usbanywhere-ctl remote <server_ip>{RESET}")
            sys.exit(1)
        list_remote_devices(args.busid)
    elif args.command in ("connect", "attach"):
        if not args.busid or not args.extra:
            print(f"{RED}Error: Missing arguments. Usage: sudo usbanywhere-ctl connect <server_ip> <busid>{RESET}")
            sys.exit(1)
        ok = connect_remote_device(args.busid, args.extra)
        sys.exit(0 if ok else 1)
    elif args.command in ("disconnect", "detach"):
        ok = disconnect_remote_device(args.busid or "all")
        sys.exit(0 if ok else 1)
    elif args.command == "ports":
        list_client_ports()
    elif args.command == "client-guard":
        sys.exit(0 if manage_client_guard(args.busid or "status") else 1)
    elif args.command == "client-sleep-hook":
        sys.exit(0 if run_client_sleep_hook(args.busid or "pre") else 1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{YELLOW}Interrupted.{RESET}")
        sys.exit(130)
