# Enforce Unix LF line endings across all scripts, control binaries, and cross-platform sources
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*ctl text eol=lf
scripts/* text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.swift text eol=lf
