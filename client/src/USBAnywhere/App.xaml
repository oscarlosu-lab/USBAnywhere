<Application x:Class="USBAnywhere.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================ -->
            <!-- OBSIDIAN PRECISION THEME (v3.2.0)            -->
            <!-- ============================================ -->
            
            <!-- Background Surfaces - Obsidian Precision -->
            <SolidColorBrush x:Key="BackgroundDark" Color="#0B0C0E"/>
            <SolidColorBrush x:Key="BackgroundPanel" Color="#131417"/>
            <SolidColorBrush x:Key="BackgroundTitleBar" Color="#16171B"/>
            <SolidColorBrush x:Key="BackgroundButton" Color="#18191E"/>
            <SolidColorBrush x:Key="BackgroundButtonHover" Color="#22242A"/>
            <SolidColorBrush x:Key="BackgroundInput" Color="#141518"/>
            
            <!-- Foreground Colors -->
            <SolidColorBrush x:Key="ForegroundPrimary" Color="#EDEDED"/>
            <SolidColorBrush x:Key="ForegroundSecondary" Color="#8E919A"/>
            <SolidColorBrush x:Key="ForegroundAccent" Color="#D2F800"/>
            
            <!-- Accent Colors - Obsidian Precision -->
            <SolidColorBrush x:Key="AccentOrange" Color="#F59E0B"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#D2F800"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#D2F800"/>
            <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#A1A1AA"/>
            <SolidColorBrush x:Key="AccentTeal" Color="#D2F800"/>
            
            <!-- macOS-style buttons -->
            <SolidColorBrush x:Key="MacCloseRed" Color="#EF4444"/>
            <SolidColorBrush x:Key="MacMinimizeYellow" Color="#F59E0B"/>
            <SolidColorBrush x:Key="MacMaximizeGreen" Color="#D2F800"/>
            
            <!-- Status Colors - Obsidian Precision -->
            <SolidColorBrush x:Key="StatusSuccess" Color="#D2F800"/>
            <SolidColorBrush x:Key="StatusWarning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="StatusError" Color="#EF4444"/>
            <SolidColorBrush x:Key="StatusInfo" Color="#A1A1AA"/>
            
            <!-- ============================================ -->
            <!-- GLOBAL STYLES                               -->
            <!-- ============================================ -->
            
            <!-- Window Style -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource BackgroundDark}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            
            <!-- Flat Button -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BackgroundButton}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="#22242A" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundButtonHover}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#333742"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#121316"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#D2F800"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Accent Action Button (High-Contrast Electric Lime) -->
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="Foreground" Value="#0B0C0E"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            <!-- TextBox Style -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                <Setter Property="BorderBrush" Value="#22242A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CaretBrush" Value="{DynamicResource ForegroundPrimary}"/>
            </Style>
            
            <!-- Label Style -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            
            <!-- TreeView Style -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource BackgroundPanel}"/>
                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="2,4"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
